.mobile-homepage,
.mobile-school-profile{
  display:none;
}

@media (max-width: 900px){
  .mobile-homepage,
  .mobile-school-profile{
    display:block;
  }

  body.home-minimal{
    background:var(--psg-bg);
  }

  body.home-minimal .home-hero,
  body.home-minimal .home-school-filter-bar,
  body.home-minimal .home-finder,
  body.home-minimal .site-footer{
    display:none !important;
  }

  .mobile-homepage{
    min-height:100svh;
    padding:14px 0 16px;
  }

  .mobile-homepage__shell{
    max-width:31rem;
  }

  .mobile-homepage__header{
    margin:0 0 10px;
    text-align:center;
  }

  .mobile-homepage__title{
    margin:0;
    color:var(--psg-dark);
    font:600 clamp(.98rem, 3.55vw, 1.08rem)/1.25 "Inter",system-ui,sans-serif;
    letter-spacing:.01em;
    white-space:nowrap;
  }

  .mobile-homepage__form{
    display:grid;
    gap:8px;
  }

  .mobile-homepage__row{
    display:grid;
    grid-template-columns:minmax(0,1fr) minmax(0,1fr);
    gap:8px;
  }

  .mobile-homepage__field{
    min-width:0;
  }

  .mobile-homepage__input,
  .mobile-dropdown__summary,
  .mobile-homepage__submit,
  .mobile-chip,
  .mobile-segmented__button,
  .mobile-check{
    border-radius:0;
  }

  .mobile-homepage__input,
  .mobile-dropdown__summary,
  .mobile-homepage__submit,
  .mobile-segmented__button,
  .mobile-check{
    min-height:42px;
    border:1px solid var(--psg-line);
    background:#fff;
    color:var(--psg-dark);
    box-shadow:none;
  }

  .mobile-homepage__input{
    width:100%;
    padding:0 13px;
    font:500 .95rem/1.2 "Inter",system-ui,sans-serif;
  }

  .mobile-homepage__input::placeholder{
    color:rgba(108,99,89,.82);
  }

  .mobile-chip-row{
    display:grid;
    grid-template-columns:repeat(7, minmax(0, 1fr));
    gap:4px;
  }

  .mobile-chip{
    min-height:38px;
    padding:0;
    border:1px solid var(--psg-line);
    background:#fff;
    color:var(--psg-dark);
    font:600 .68rem/1 "Inter",system-ui,sans-serif;
    letter-spacing:.06em;
    text-transform:uppercase;
    cursor:pointer;
  }

  .mobile-chip.is-active,
  .mobile-segmented__button.is-active,
  .mobile-school-sections__button.is-active,
  .mobile-school-topbar__action.is-active{
    background:var(--psg-dark);
    border-color:var(--psg-dark);
    color:var(--psg-white);
  }

  .mobile-chip:focus-visible,
  .mobile-chip:hover,
  .mobile-dropdown__summary:hover,
  .mobile-dropdown__summary:focus-visible,
  .mobile-segmented__button:hover,
  .mobile-segmented__button:focus-visible,
  .mobile-homepage__submit:hover,
  .mobile-homepage__submit:focus-visible,
  .mobile-check:hover,
  .mobile-check:focus-within,
  .mobile-school-topbar__link:hover,
  .mobile-school-topbar__link:focus-visible,
  .mobile-school-topbar__shortlist:hover,
  .mobile-school-topbar__shortlist:focus-visible,
  .mobile-school-topbar__action:hover,
  .mobile-school-topbar__action:focus-visible,
  .mobile-school-topbar__pager:hover,
  .mobile-school-topbar__pager:focus-visible,
  .mobile-school-sections__button:hover,
  .mobile-school-sections__button:focus-visible,
  .subject-toggle:hover,
  .subject-toggle:focus-visible{
    border-color:rgba(179,91,46,.48);
    color:var(--psg-accent);
    outline:none;
  }

  .mobile-homepage__field--panel-left,
  .mobile-homepage__field--panel-right{
    position:relative;
    z-index:4;
  }

  .mobile-dropdown{
    position:relative;
  }

  .mobile-dropdown__summary{
    display:flex;
    align-items:center;
    justify-content:space-between;
    width:100%;
    padding:0 12px;
    list-style:none;
    cursor:pointer;
    user-select:none;
  }

  .mobile-dropdown__summary::-webkit-details-marker{
    display:none;
  }

  .mobile-dropdown__summary::after{
    content:'▾';
    flex:0 0 auto;
    margin-left:10px;
    color:var(--psg-muted);
    font-size:.86rem;
  }

  .mobile-dropdown[open] .mobile-dropdown__summary::after{
    content:'▴';
  }

  .mobile-dropdown__value{
    display:block;
    min-width:0;
    overflow:hidden;
    color:var(--psg-dark);
    font:600 .8rem/1.15 "Inter",system-ui,sans-serif;
    letter-spacing:.01em;
    text-overflow:ellipsis;
    white-space:nowrap;
  }

  .mobile-dropdown__panel{
    position:absolute;
    top:calc(100% + 4px);
    left:0;
    z-index:30;
    width:100%;
    max-height:min(18rem, 46svh);
    overflow:auto;
    border:1px solid var(--psg-line);
    background:#fff;
    box-shadow:0 12px 28px rgba(22,17,12,.14);
  }

  .mobile-dropdown__panel--religion{
    width:min(94vw, 26rem);
    max-width:min(94vw, 26rem);
    left:auto;
    right:0;
  }

  .mobile-dropdown__options{
    display:grid;
    gap:0;
  }

  .mobile-dropdown__option{
    display:flex;
    align-items:flex-start;
    gap:10px;
    padding:10px 12px;
    border-top:1px solid rgba(41,36,33,.09);
    color:var(--psg-dark);
    font:500 .86rem/1.35 "Inter",system-ui,sans-serif;
  }

  .mobile-dropdown__option:first-child{
    border-top:0;
  }

  .mobile-dropdown__option input{
    flex:0 0 auto;
    margin:2px 0 0;
  }

  .mobile-segmented{
    display:grid;
    grid-template-columns:repeat(2, minmax(0,1fr));
    gap:4px;
  }

  .mobile-segmented__button{
    padding:0 8px;
    font:600 .76rem/1 "Inter",system-ui,sans-serif;
    letter-spacing:.06em;
    text-transform:uppercase;
    cursor:pointer;
  }

  .mobile-range{
    border:1px solid var(--psg-line);
    background:#fff;
    padding:8px 10px 9px;
  }

  .mobile-range__header{
    display:flex;
    align-items:center;
    justify-content:space-between;
    gap:8px;
    margin-bottom:8px;
  }

  .mobile-range__title{
    color:var(--psg-dark);
    font:600 .74rem/1.2 "Inter",system-ui,sans-serif;
    letter-spacing:.08em;
    text-transform:uppercase;
  }

  .mobile-range__values{
    display:inline-flex;
    align-items:center;
    gap:5px;
    min-width:0;
    color:var(--psg-dark);
    font:600 .8rem/1.1 "Inter",system-ui,sans-serif;
    white-space:nowrap;
  }

  .mobile-range__track{
    position:relative;
    height:22px;
  }

  .mobile-range__fill{
    position:absolute;
    top:9px;
    left:0;
    right:0;
    height:4px;
    background:linear-gradient(90deg, rgba(41,36,33,.12) 0%, rgba(41,36,33,.12) 100%);
    pointer-events:none;
  }

  .mobile-range__input{
    -webkit-appearance:none;
    appearance:none;
    position:absolute;
    left:0;
    width:100%;
    height:22px;
    margin:0;
    background:transparent;
    pointer-events:none;
  }

  .mobile-range__input::-webkit-slider-runnable-track{
    height:4px;
    background:transparent;
  }

  .mobile-range__input::-moz-range-track{
    height:4px;
    background:transparent;
    border:0;
  }

  .mobile-range__input::-webkit-slider-thumb{
    -webkit-appearance:none;
    appearance:none;
    width:16px;
    height:16px;
    margin-top:-6px;
    border:2px solid var(--psg-dark);
    background:#fff;
    pointer-events:auto;
    cursor:pointer;
  }

  .mobile-range__input::-moz-range-thumb{
    width:16px;
    height:16px;
    border:2px solid var(--psg-dark);
    background:#fff;
    border-radius:0;
    pointer-events:auto;
    cursor:pointer;
  }

  .mobile-range__input:focus-visible{
    outline:none;
  }

  .mobile-range__input:focus-visible::-webkit-slider-thumb{
    border-color:var(--psg-accent);
  }

  .mobile-range__input:focus-visible::-moz-range-thumb{
    border-color:var(--psg-accent);
  }

  .mobile-must-have{
    display:flex;
    align-items:center;
    flex-wrap:nowrap;
    gap:8px;
    min-width:0;
  }

  .mobile-must-have__label{
    flex:0 0 auto;
    color:var(--psg-dark);
    font:600 .75rem/1 "Inter",system-ui,sans-serif;
    letter-spacing:.08em;
    text-transform:uppercase;
  }

  .mobile-check{
    display:inline-flex;
    align-items:center;
    gap:7px;
    padding:0 9px;
    white-space:nowrap;
    font:500 .8rem/1 "Inter",system-ui,sans-serif;
  }

  .mobile-check input{
    margin:0;
  }

  .mobile-homepage__error{
    min-height:1.1rem;
    margin:0;
    color:#9b3225;
    font-size:.78rem;
    line-height:1.35;
    text-align:center;
  }

  .mobile-homepage__actions{
    padding-top:2px;
  }

  .mobile-homepage__submit{
    display:flex;
    align-items:center;
    justify-content:center;
    width:100%;
    padding:0 12px;
    background:var(--psg-dark);
    border-color:var(--psg-dark);
    color:var(--psg-white);
    font:600 .82rem/1 "Inter",system-ui,sans-serif;
    letter-spacing:.08em;
    text-transform:uppercase;
    cursor:pointer;
  }

  .mobile-homepage__submit:disabled,
  .mobile-school-topbar__pager:disabled,
  .mobile-school-topbar__action:disabled{
    opacity:.45;
    cursor:default;
  }

  body.school-profile-page{
    background:var(--psg-bg);
  }

  body.school-profile-page .site-header,
  body.school-profile-page .school-profile-hero,
  body.school-profile-page .school-back-strip,
  body.school-profile-page .school-compare-floating-bar,
  body.school-profile-page .page-shell,
  body.school-profile-page .site-footer{
    display:none !important;
  }

  .mobile-school-profile{
    padding-bottom:24px;
  }

  .mobile-school-topbar{
    position:sticky;
    top:0;
    z-index:35;
    background:var(--psg-bg);
    border-bottom:1px solid var(--psg-line);
  }

  .mobile-school-topbar__row{
    display:grid;
    grid-template-columns:minmax(0,1fr) auto auto;
    align-items:center;
    gap:8px;
    width:min(100%, 1440px);
    margin:0 auto;
    padding:9px 18px;
  }

  .mobile-school-topbar__row--pager{
    grid-template-columns:auto minmax(0,1fr) auto;
    border-top:1px solid rgba(41,36,33,.08);
    padding-top:8px;
    padding-bottom:8px;
  }

  .mobile-school-topbar__link,
  .mobile-school-topbar__shortlist,
  .mobile-school-topbar__action,
  .mobile-school-topbar__pager{
    min-height:34px;
    border:1px solid var(--psg-line);
    background:#fff;
    color:var(--psg-dark);
    font:600 .68rem/1 "Inter",system-ui,sans-serif;
    letter-spacing:.08em;
    text-transform:uppercase;
  }

  .mobile-school-topbar__link,
  .mobile-school-topbar__shortlist{
    display:inline-flex;
    align-items:center;
    justify-content:center;
    gap:7px;
    padding:0 10px;
  }

  .mobile-school-topbar__action,
  .mobile-school-topbar__pager{
    padding:0 10px;
    cursor:pointer;
  }

  .mobile-school-topbar__count{
    display:inline-grid;
    place-items:center;
    min-width:1.5rem;
    min-height:1.5rem;
    padding:0 .25rem;
    background:var(--psg-dark);
    color:var(--psg-white);
    font-size:.66rem;
  }

  .mobile-school-topbar__position{
    margin:0;
    text-align:center;
    color:var(--psg-dark);
    font:600 .72rem/1.2 "Inter",system-ui,sans-serif;
    letter-spacing:.08em;
    text-transform:uppercase;
  }

  .mobile-school-hero{
    position:relative;
    min-height:252px;
    background:#8e8a86;
    color:var(--psg-white);
  }

  .mobile-school-hero__media,
  .mobile-school-hero__fallback,
  .mobile-school-hero__overlay{
    position:absolute;
    inset:0;
  }

  .mobile-school-hero__fallback{
    background:linear-gradient(180deg, #8f8a85 0%, #7c7772 100%);
  }

  .mobile-school-hero__media{
    overflow:hidden;
  }

  .mobile-school-hero__slide{
    position:absolute;
    inset:0;
    width:100%;
    height:100%;
    object-fit:cover;
    opacity:0;
    transition:opacity .35s ease;
  }

  .mobile-school-hero__slide.is-active{
    opacity:1;
  }

  .mobile-school-hero__overlay{
    background:linear-gradient(180deg, rgba(22,18,15,.18) 0%, rgba(22,18,15,.3) 36%, rgba(22,18,15,.7) 100%);
    pointer-events:none;
  }

  .mobile-school-hero__copy{
    position:relative;
    z-index:2;
    display:flex;
    flex-direction:column;
    justify-content:flex-end;
    min-height:252px;
    padding-top:44px;
    padding-bottom:18px;
  }

  .mobile-school-hero__title{
    margin:0;
    font-family:"EB Garamond",ui-serif,Georgia,serif;
    font-size:2.05rem;
    font-weight:500;
    line-height:.95;
    letter-spacing:.03em;
    text-transform:uppercase;
  }

  .mobile-school-hero__address,
  .mobile-school-hero__subhead{
    margin:8px 0 0;
    max-width:34rem;
    color:rgba(250,247,242,.94);
    font-size:.9rem;
    line-height:1.45;
  }

  .mobile-school-hero__subhead{
    font-size:.84rem;
    color:rgba(250,247,242,.88);
  }

  .mobile-school-hero__controls{
    position:absolute;
    right:12px;
    bottom:12px;
    z-index:3;
    display:flex;
    align-items:center;
    gap:7px;
  }

  .mobile-school-hero__control,
  .mobile-school-hero__dot{
    border:1px solid rgba(250,247,242,.5);
    background:rgba(22,18,15,.34);
    color:var(--psg-white);
  }

  .mobile-school-hero__control{
    width:30px;
    height:30px;
    cursor:pointer;
  }

  .mobile-school-hero__dots{
    display:flex;
    gap:5px;
  }

  .mobile-school-hero__dot{
    width:10px;
    height:10px;
    padding:0;
  }

  .mobile-school-hero__dot.is-active{
    background:var(--psg-white);
  }

  .mobile-school-sections{
    position:sticky;
    top:96px;
    z-index:30;
    border-top:1px solid var(--psg-line);
    border-bottom:1px solid var(--psg-line);
    background:rgba(244,239,232,.98);
    backdrop-filter:blur(8px);
  }

  .mobile-school-sections__inner{
    display:grid;
    grid-template-columns:repeat(4, minmax(0,1fr));
    gap:0;
    padding-top:0;
    padding-bottom:0;
  }

  .mobile-school-sections__button{
    min-height:42px;
    border:0;
    border-right:1px solid var(--psg-line);
    background:transparent;
    color:var(--psg-dark);
    font:600 .72rem/1 "Inter",system-ui,sans-serif;
    letter-spacing:.08em;
    text-transform:uppercase;
    cursor:pointer;
  }

  .mobile-school-sections__button:last-child{
    border-right:0;
  }

  .mobile-school-content{
    display:grid;
    gap:16px;
    padding-top:16px;
  }

  .mobile-school-panel{
    display:grid;
    gap:14px;
  }

  .mobile-school-card{
    border:1px solid var(--psg-line);
    background:#fff;
    padding:15px 14px;
  }

  .mobile-school-card h2{
    margin:0 0 12px;
    color:var(--psg-dark);
    font-family:"EB Garamond",ui-serif,Georgia,serif;
    font-size:1.48rem;
    font-weight:500;
    line-height:.95;
    letter-spacing:.04em;
    text-transform:uppercase;
  }

  .mobile-school-card p,
  .mobile-school-card li,
  .mobile-school-card div{
    color:var(--psg-ink);
  }

  .mobile-school-card p{
    margin:0 0 10px;
    font-size:.94rem;
    line-height:1.55;
  }

  .mobile-school-card p:last-child{
    margin-bottom:0;
  }

  .mobile-school-card ul{
    margin:0;
    padding-left:1.15rem;
  }

  .mobile-school-card li + li{
    margin-top:.4rem;
  }

  .mobile-school-card--overview{
    padding-top:10px;
    padding-bottom:10px;
  }

  .mobile-overview-list{
    display:grid;
    gap:0;
  }

  .mobile-overview-list__item{
    display:grid;
    gap:4px;
    padding:10px 0;
    border-top:1px solid rgba(41,36,33,.1);
    text-align:center;
  }

  .mobile-overview-list__item:last-child{
    border-bottom:1px solid rgba(41,36,33,.1);
  }

  .mobile-overview-list__label{
    color:var(--psg-muted);
    font:600 .7rem/1.2 "Inter",system-ui,sans-serif;
    letter-spacing:.08em;
    text-transform:uppercase;
  }

  .mobile-overview-list__value{
    color:var(--psg-dark);
    font:600 .96rem/1.45 "Inter",system-ui,sans-serif;
  }

  .mobile-school-map-wrap{
    width:100vw;
    margin-left:calc(50% - 50vw);
  }

  .mobile-school-map{
    width:100%;
    height:240px;
    background:#ddd7ce;
  }

  .mobile-school-map-pin{
    width:16px;
    height:16px;
    background:var(--psg-dark);
    border:2px solid #fff;
    box-shadow:0 2px 8px rgba(22,18,15,.18);
  }

  .mobile-school-map-pin--current{
    width:22px;
    height:22px;
    background:var(--psg-accent);
    border:3px solid #fff;
  }

  .mobile-fee-table{
    border-top:1px solid rgba(41,36,33,.1);
  }

  .mobile-fee-table__row{
    display:grid;
    grid-template-columns:minmax(0,1fr) auto;
    gap:12px;
    padding:8px 0;
    border-bottom:1px solid rgba(41,36,33,.1);
  }

  .mobile-fee-table__year{
    color:var(--psg-muted);
    font-size:.92rem;
  }

  .mobile-fee-table__amount{
    color:var(--psg-dark);
    font-size:.94rem;
  }

  .mobile-school-yes-no{
    margin:0;
    color:var(--psg-dark);
    font:600 1.3rem/1 "EB Garamond",ui-serif,Georgia,serif;
    letter-spacing:.04em;
    text-transform:uppercase;
  }

  .tile-kpis{
    display:grid;
    grid-template-columns:repeat(3, minmax(0,1fr));
    gap:8px;
    margin-bottom:10px;
  }

  .tile-kpi{
    border:1px solid rgba(41,36,33,.1);
    padding:8px;
    background:var(--psg-bg);
  }

  .tile-kpi-label{
    display:block;
    color:var(--psg-muted);
    font:600 .67rem/1.25 "Inter",system-ui,sans-serif;
    letter-spacing:.08em;
    text-transform:uppercase;
  }

  .tile-kpi-value{
    display:block;
    margin-top:6px;
    color:var(--psg-dark);
    font:600 1.08rem/1 "Inter",system-ui,sans-serif;
  }

  .tile-note{
    color:var(--psg-muted);
    font-size:.84rem;
  }

  .metric-list{
    display:grid;
    gap:0;
    border-top:1px solid rgba(41,36,33,.1);
  }

  .metric-row{
    display:grid;
    grid-template-columns:minmax(0,1fr) auto;
    gap:12px;
    padding:8px 0;
    border-bottom:1px solid rgba(41,36,33,.1);
  }

  .metric-name{
    color:var(--psg-ink);
    font-size:.92rem;
  }

  .metric-value{
    color:var(--psg-dark);
    font-weight:600;
  }

  .subject-toggle{
    display:inline-flex;
    align-items:center;
    justify-content:center;
    min-height:38px;
    margin-top:10px;
    padding:0 12px;
    border:1px solid var(--psg-line);
    background:#fff;
    color:var(--psg-dark);
    font:600 .72rem/1 "Inter",system-ui,sans-serif;
    letter-spacing:.08em;
    text-transform:uppercase;
    cursor:pointer;
  }

  .subject-extra[hidden]{
    display:none !important;
  }

  .school-card-copy p + p,
  .school-card-copy ul + p,
  .school-card-copy p + ul{
    margin-top:10px;
  }

  .mobile-school-map .leaflet-control-zoom a{
    border-radius:0 !important;
  }

  .mobile-school-map .leaflet-popup-content-wrapper,
  .mobile-school-map .leaflet-popup-tip{
    border-radius:0;
    box-shadow:0 12px 28px rgba(22,18,15,.16);
  }

  .mobile-school-map .leaflet-popup-content{
    margin:12px 14px;
    font:500 .86rem/1.45 "Inter",system-ui,sans-serif;
  }

  .mobile-school-map .leaflet-popup-content h3{
    margin:0 0 4px;
    color:var(--psg-dark);
    font-family:"EB Garamond",ui-serif,Georgia,serif;
    font-size:1.15rem;
    font-weight:500;
    line-height:1;
    letter-spacing:.03em;
    text-transform:uppercase;
  }

  .mobile-school-map .leaflet-popup-content p{
    margin:0 0 6px;
    color:var(--psg-ink);
    font-size:.82rem;
  }

  .mobile-school-map .leaflet-popup-content a{
    color:var(--psg-accent);
    font-weight:600;
  }
}
