---
import LocationSideNav from './LocationSideNav.astro';
import { getLocationPresentation } from '../lib/location-config';

const currentSection = Astro.props.currentSection || 'overview';
const presentation = getLocationPresentation({ name: 'Bath' });
const nav = {
  ...presentation.nav,
  movingToSection: true
};
---
<LocationSideNav locationSlug="bath" locationName="Bath" nav={nav} currentSection={currentSection} />
