---
import BaseLayout from '../layouts/BaseLayout.astro';
import SiteHeader from './SiteHeader.astro';
import SiteFooter from './SiteFooter.astro';
import {
  formatCurrency,
  formatPercent,
  formatInteger,
  splitParagraphs
} from '../lib/directory';

const {
  profile,
  title,
  description,
  canonicalPath
} = Astro.props;

const schoolMapScript = `window.schoolProfileMapData = ${JSON.stringify(profile.mapData)};`;
const schoolNearbyMapScript = `window.schoolProfileNearbyMapData = ${JSON.stringify(profile.nearbyMapSchools || [])};`;
const schoolMapJson = JSON.stringify(profile.mapData);
const schoolNearbyMapJson = JSON.stringify(profile.nearbyMapSchools || []);

const heroSlides = Array.from(
  new Map(
    [
      { url: profile.heroImageUrl, alt: profile.heroImageAlt || `${profile.school.name} hero image`, imageType: 'hero' },
      ...(profile.galleryImages || [])
    ]
      .filter((image) => Boolean(image?.url))
      .map((image) => [image.url, image])
  ).values()
);

const hasHeroMedia = heroSlides.length > 0;
const yearLabels = [
  'Pre-Reception',
  'Reception',
  'Year 1',
  'Year 2',
  'Year 3',
  'Year 4',
  'Year 5',
  'Year 6',
  'Year 7',
  'Year 8',
  'Year 9',
  'Year 10',
  'Year 11',
  'Year 12',
  'Year 13'
];

function flattenFeeRows(pane: any) {
  return Array.isArray(pane?.columns) ? pane.columns.flat() : [];
}

function buildFullFeeRows(pane: any) {
  const lookup = new Map(
    flattenFeeRows(pane).map((row: any) => [row.year_group_label, formatCurrency(row.amount_gbp)])
  );

  return yearLabels.map((label) => ({
    yearLabel: label,
    amountLabel: lookup.get(label) || '—'
  }));
}

function averageFeeForTypes(types: string[]) {
  const values = (profile.feePanes || [])
    .filter((pane: any) => types.includes(pane.feeType))
    .flatMap((pane: any) => flattenFeeRows(pane))
    .map((row: any) => Number(row.amount_gbp))
    .filter((value: number) => Number.isFinite(value) && value > 0);

  if (!values.length) return null;
  return values.reduce((sum: number, value: number) => sum + value, 0) / values.length;
}

const feePanes = (profile.feePanes || []).map((pane: any) => ({
  ...pane,
  allRows: buildFullFeeRows(pane)
}));

const averageDayFee = averageFeeForTypes(['day']);
const averageBoardingFee = averageFeeForTypes(['weekly_boarding', 'full_boarding']);

const averageFeeLabel = averageDayFee !== null && averageBoardingFee !== null
  ? `Day ${formatCurrency(averageDayFee)} · Boarding ${formatCurrency(averageBoardingFee)} (annual, inc. VAT)`
  : averageDayFee !== null
    ? `${formatCurrency(averageDayFee)} (annual, inc. VAT)`
    : averageBoardingFee !== null
      ? `${formatCurrency(averageBoardingFee)} (annual, inc. VAT)`
      : '—';

function getAtGlanceValue(label: string) {
  const row = (profile.atGlanceRows || []).find((entry: any) => entry.label === label);
  return row ? row.value : '—';
}

function hasText(value: unknown) {
  return String(value || '').replace(/\s+/g, ' ').trim().length > 0;
}

function pickFirstTextValue(record: Record<string, unknown> | null | undefined, keys: string[]) {
  if (!record) return null;
  for (const key of keys) {
    const value = record[key];
    if (hasText(value)) return String(value).replace(/\s+/g, ' ').trim();
  }
  return null;
}

const isSeniorSchool = Boolean(profile.school?.official_sixth_form)
  || Number(profile.school?.age_max) >= 16
  || /senior/i.test(String(profile.phaseLabel || ''));
const hasScholarships = hasText(profile.content?.scholarships);
const hasBursaries = profile.bursary?.has_bursaries === true || (!profile.bursary || profile.bursary?.has_bursaries == null ? hasText(profile.bursary?.summary) : false);
const religionValue = getAtGlanceValue('Religion');
const studentsValue = getAtGlanceValue('Students');
const nurseryValue = getAtGlanceValue('Nursery') === 'Has a nursery' ? 'Yes' : 'No';
const linkedSeniorSchool = pickFirstTextValue(profile.content, [
  'linked_senior_school',
  'linked_senior',
  'linked_senior_school_name',
  'linked_school',
  'senior_school_link'
]);

const overviewRows = [
  { label: 'Age range', value: profile.ageLabel || '—' },
  { label: 'Co-ed status', value: profile.genderLabel || '—' },
  { label: 'Number of students', value: studentsValue || '—' },
  { label: 'Day / boarding', value: profile.formatLabel || '—' },
  { label: 'Religious affiliation', value: religionValue || '—' },
  { label: 'Average fees', value: averageFeeLabel },
  { label: 'Has a nursery', value: nurseryValue }
];

const feeNote = profile.allFeesIncludeVat
  ? `Annual fees including VAT${profile.currentAcademicYear ? ` · ${profile.currentAcademicYear}` : ''}.`
  : `Annual fees${profile.currentAcademicYear ? ` · ${profile.currentAcademicYear}` : ''}. Please check the school for VAT treatment.`;
---
<BaseLayout
  title={title || `${profile.school.name} | ${profile.location.name} school profile`}
  description={description || profile.subhead}
  canonicalPath={canonicalPath || profile.canonicalPath}
  includeLeaflet={true}
  bodyClass="school-profile-page"
  dataLocationSlug={profile.location.slug}
  dataSchoolSlug={profile.school.slug}
>
  <Fragment slot="head">
    <link rel="stylesheet" href="/assets/css/styles.css" />
    <link rel="stylesheet" href="/assets/css/bath-refined.css?v=20260416a-school-hero-search-back" />
    <link rel="stylesheet" href="/assets/css/mobile-redesign.css?v=20260418b-mobile-compact" />
  </Fragment>

  <a class="skip-link" href="#main">Skip to content</a>
  <SiteHeader minimal={true} />

  <section class="school-mobile-topbar shell" aria-label="School navigation">
    <div class="school-mobile-topbar__row">
      <a class="school-mobile-topbar__link" data-restore-search-link href={profile.changeSearchHref}>Back to results</a>
      <a class="school-mobile-topbar__shortlist" href="/shortlist/">
        <span>View shortlist</span>
        <span class="school-mobile-topbar__shortlist-count" data-shortlist-count>0</span>
      </a>
      <button
        class="school-mobile-topbar__action"
        data-shortlist-add-label="Add to shortlist"
        data-shortlist-button
        data-shortlist-remove-label="Shortlisted"
        data-shortlist-school-id={profile.school.id}
        type="button"
      >Add to shortlist</button>
    </div>
    <div class="school-mobile-topbar__row school-mobile-topbar__row--results" data-school-results-nav hidden>
      <button class="school-mobile-topbar__pager" data-school-prev type="button">Prev</button>
      <p class="school-mobile-topbar__position" data-school-results-label>School profile</p>
      <button class="school-mobile-topbar__pager" data-school-next type="button">Next</button>
    </div>
  </section>

  <section aria-labelledby="school-page-title" class={`school-profile-hero ${heroSlides.length > 1 ? 'school-profile-hero--slideshow' : ''} ${!hasHeroMedia ? 'school-profile-hero--compact' : ''}`}>
    {hasHeroMedia ? (
      <div class="school-profile-hero-media" data-hero-slideshow={heroSlides.length > 1 ? 'true' : undefined}>
        {heroSlides.map((image: any, index: number) => (
          <img
            alt={image.alt || `${profile.school.name} image ${index + 1}`}
            class={`school-profile-hero-slide ${index === 0 ? 'is-active' : ''}`}
            data-hero-slide
            loading={index === 0 ? 'eager' : 'lazy'}
            src={image.url}
          />
        ))}

        {heroSlides.length > 1 ? (
          <div class="school-profile-hero-controls" aria-label="School image gallery controls">
            <button aria-label="Previous school image" class="school-profile-hero-control" data-hero-prev type="button">←</button>
            <div class="school-profile-hero-dots" role="tablist" aria-label="School image slides">
              {heroSlides.map((image: any, index: number) => (
                <button
                  aria-label={`Show image ${index + 1}`}
                  class={`school-profile-hero-dot ${index === 0 ? 'is-active' : ''}`}
                  data-hero-dot
                  data-hero-index={index}
                  type="button"
                ></button>
              ))}
            </div>
            <button aria-label="Next school image" class="school-profile-hero-control" data-hero-next type="button">→</button>
          </div>
        ) : null}
      </div>
    ) : null}
    <div class="school-profile-hero-copy">
      {(profile.profileBadgeLabel || profile.profileManagedLabel) ? (
        <div class="school-profile-status-row">
          {profile.profileBadgeLabel ? <p class="school-profile-status school-profile-status--featured">{profile.profileBadgeLabel}</p> : null}
          {profile.profileManagedLabel ? <p class="school-profile-status">{profile.profileManagedLabel}</p> : null}
        </div>
      ) : null}
      <h1 class="school-profile-title" id="school-page-title">{profile.school.name}</h1>
      <p class="school-profile-address">{profile.address}</p>
      <p class="school-profile-subhead">{profile.subhead}</p>
      {(profile.officialWebsiteUrl || profile.contactFormUrl || profile.school.id) ? (
        <div class="school-profile-actions">
          {profile.officialWebsiteUrl ? <a class="button school-profile-website-link" href={profile.officialWebsiteUrl} rel="noopener noreferrer" target="_blank">Visit school website</a> : null}
          {profile.contactFormUrl ? <a class="button-outline school-profile-contact-link" href={profile.contactFormUrl} rel="noopener noreferrer" target="_blank">Admissions / contact form</a> : null}
          <button
            class="button-outline school-profile-shortlist-button"
            data-shortlist-add-label="Add to shortlist"
            data-shortlist-button
            data-shortlist-remove-label="Remove from shortlist"
            data-shortlist-school-id={profile.school.id}
            type="button"
          >Add to shortlist</button>
        </div>
      ) : null}
    </div>
  </section>

  <nav class="school-mobile-section-nav" aria-label="School sections">
    <div class="shell school-mobile-section-nav__inner">
      <button class="school-mobile-section-nav__button is-active" data-school-section-target="overview" type="button">Overview</button>
      <button class="school-mobile-section-nav__button" data-school-section-target="fees" type="button">Fees</button>
      <button class="school-mobile-section-nav__button" data-school-section-target="academics" type="button">Academics</button>
      <button class="school-mobile-section-nav__button" data-school-section-target="about" type="button">About</button>
    </div>
  </nav>

  <div class="school-back-strip"><div class="shell"><a class="school-back-link" data-restore-search-link href={profile.changeSearchHref}>← Back to search results</a></div></div>
  <div class="school-compare-floating-bar" data-compare-floating-bar hidden>
    <div class="shell school-compare-floating-bar__inner">
      <p class="school-compare-floating-bar__text" data-compare-floating-label>Comparing schools</p>
      <button class="school-compare-floating-bar__button" data-compare-floating-close type="button">Close comparison school ×</button>
    </div>
  </div>

  <main class="page-shell" id="main">
    <div class="shell school-profile-layout">
      <aside class="school-side-column" data-school-mobile-section="overview">
        <section class="school-side-section school-overview-summary">
          <p class="nav-kicker">Overview</p>
          <div class="school-overview-list">
            {overviewRows.map((row) => (
              <div class="school-overview-item">
                <span class="school-overview-label">{row.label}</span>
                <strong class="school-overview-value">{row.value}</strong>
              </div>
            ))}
          </div>
        </section>

        <section class="school-side-section school-compare-section school-desktop-only">
          <div class="school-compare-section-head">
            <p class="nav-kicker">Compare with</p>
            <button aria-controls="school-compare-links-panel" aria-expanded="false" class="school-compare-toggle" data-compare-toggle type="button">Compare with nearby schools</button>
          </div>
          <div class="school-compare-links-panel" data-compare-links-panel hidden id="school-compare-links-panel">
            <ul class="school-compare-links">
              {(profile.compareLinks || []).map((link: any) => (
                <li>
                  <a data-compare-school={link.slug} href={`?compare=${encodeURIComponent(link.slug)}`}>{link.name}</a>
                </li>
              ))}
            </ul>
            <button class="school-compare-toggle school-compare-toggle--secondary" data-compare-hide type="button">Hide nearby schools</button>
          </div>
        </section>
      </aside>

      <section class="school-profile-main">
        <div class="school-feature-grid">
          {feePanes.length > 0 && (
            <article class={`school-feature-tile ${feePanes.length > 1 ? 'tile-expandable' : ''}`} data-school-mobile-section="fees">
              <h2>Fee profile</h2>
              <div class="school-feature-body">
                <p class="tile-note">{feeNote}</p>

                {feePanes.length > 1 && (
                  <div class="fee-switch" data-fee-switch>
                    {feePanes.map((pane: any, index: number) => (
                      <button class={index === 0 ? 'is-active' : undefined} data-fee-target={pane.feeType} type="button">{pane.label}</button>
                    ))}
                  </div>
                )}

                {feePanes.map((pane: any, index: number) => (
                  <div class={`fee-pane ${index === 0 ? 'is-active' : ''}`} data-fee-pane={pane.feeType}>
                    <div class="mobile-fee-table" role="table" aria-label={`${pane.label} fee profile`}>
                      {pane.allRows.map((row: any) => (
                        <div class="mobile-fee-table__row" role="row">
                          <span class="mobile-fee-table__year" role="cell">{row.yearLabel}</span>
                          <span class="mobile-fee-table__amount" role="cell">{row.amountLabel}</span>
                        </div>
                      ))}
                    </div>
                  </div>
                ))}
              </div>
            </article>
          )}

          <article class="school-feature-tile" data-school-mobile-section="fees">
            <h2>Bursaries</h2>
            <div class="school-feature-body">
              <p class="school-yes-no school-yes-no--lead">{hasBursaries ? 'Yes' : 'No'}</p>
              {profile.bursary?.status_label ? <p>{profile.bursary.status_label}</p> : null}
              {profile.bursary?.summary ? <p>{profile.bursary.summary}</p> : null}
            </div>
          </article>

          <article class="school-feature-tile" data-school-mobile-section="fees">
            <h2>Scholarships</h2>
            <div class="school-feature-body">
              <p class="school-yes-no school-yes-no--lead">{hasScholarships ? 'Yes' : 'No'}</p>
              {profile.content?.scholarships ? (
                profile.scholarshipBullets.length > 1 ? (
                  <div class="school-card-copy">
                    <ul>
                      {profile.scholarshipBullets.map((item: string) => <li>{item}</li>)}
                    </ul>
                  </div>
                ) : (
                  splitParagraphs(profile.content.scholarships).map((paragraph: string) => <p>{paragraph}</p>)
                )
              ) : null}
            </div>
          </article>

          {profile.alevelResult ? (
            <article class="school-feature-tile" data-school-mobile-section="academics">
              <h2>A-level results</h2>
              <div class="school-feature-body">
                <div class="tile-kpis">
                  <div class="tile-kpi"><span class="tile-kpi-label">% A*–A</span><span class="tile-kpi-value">{formatPercent(profile.alevelResult.pct_a_star_a)}</span></div>
                  <div class="tile-kpi"><span class="tile-kpi-label">% A*–B</span><span class="tile-kpi-value">{formatPercent(profile.alevelResult.pct_a_star_b)}</span></div>
                  <div class="tile-kpi"><span class="tile-kpi-label">Different A-level subjects</span><span class="tile-kpi-value">{formatInteger(profile.alevelResult.unique_subjects)}</span></div>
                </div>
                <p class="tile-note">Results shown for {profile.alevelResult.result_year}.</p>
              </div>
            </article>
          ) : isSeniorSchool ? (
            <article class="school-feature-tile" data-school-mobile-section="academics">
              <h2>A-level results</h2>
              <div class="school-feature-body">
                <p>No A-level results are currently published for this school.</p>
              </div>
            </article>
          ) : null}

          {profile.subjectRows.length > 0 ? (
            <article class={`school-feature-tile ${profile.subjectExtraRows.length ? 'tile-expandable' : ''}`} data-school-mobile-section="academics">
              <h2>Popular subjects</h2>
              <div class="school-feature-body">
                <p class="tile-note">By percentage of all A-level exams taken.</p>
                <div class="metric-list">
                  {profile.subjectTopRows.map((subject: any) => (
                    <div class="metric-row"><span class="metric-name">{subject.subject_name}</span><span class="metric-value">{formatPercent(subject.share_of_entries)}</span></div>
                  ))}
                </div>
                {profile.subjectExtraRows.length > 0 && (
                  <Fragment>
                    <button class="subject-toggle" data-subject-toggle="expand" type="button">Show full subject mix</button>
                    <div class="subject-extra" hidden>
                      <div class="metric-list">
                        {profile.subjectExtraRows.map((subject: any) => (
                          <div class="metric-row"><span class="metric-name">{subject.subject_name}</span><span class="metric-value">{formatPercent(subject.share_of_entries)}</span></div>
                        ))}
                      </div>
                      <button class="subject-toggle subject-toggle--collapse" data-subject-toggle="collapse" type="button">Collapse subject mix</button>
                    </div>
                  </Fragment>
                )}
              </div>
            </article>
          ) : null}

          {!isSeniorSchool && profile.content?.assessment_approach ? (
            <article class="school-feature-tile" data-school-mobile-section="academics">
              <h2>Assessment approach</h2>
              <div class="school-feature-body">
                <div class="school-card-copy">
                  {profile.assessmentBullets.length > 1 ? (
                    <ul>
                      {profile.assessmentBullets.map((item: string) => <li>{item}</li>)}
                    </ul>
                  ) : (
                    splitParagraphs(profile.content.assessment_approach).map((paragraph: string) => <p>{paragraph}</p>)
                  )}
                </div>
              </div>
            </article>
          ) : null}

          {!isSeniorSchool && linkedSeniorSchool ? (
            <article class="school-feature-tile" data-school-mobile-section="academics">
              <h2>Linked senior school</h2>
              <div class="school-feature-body">
                <p>{linkedSeniorSchool}</p>
              </div>
            </article>
          ) : null}

          {profile.content?.admissions_summary ? (
            <article class="school-feature-tile" data-school-mobile-section="academics">
              <h2>Admissions</h2>
              <div class="school-feature-body">
                <div class="school-card-copy">
                  {splitParagraphs(profile.content.admissions_summary).map((paragraph: string) => <p>{paragraph}</p>)}
                </div>
              </div>
            </article>
          ) : null}

          <article class="school-feature-tile" data-school-mobile-section="about">
            <h2>How the school describes itself</h2>
            <div class="school-feature-body">
              <div class="school-card-copy">
                {profile.schoolVoice.length > 0 ? (
                  <ul>
                    {profile.schoolVoice.map((item: string) => <li>{item}</li>)}
                  </ul>
                ) : (
                  <p>Coming soon</p>
                )}
              </div>
            </div>
          </article>

          <article class="school-feature-tile" data-school-mobile-section="about">
            <h2>Parents like</h2>
            <div class="school-feature-body">
              <div class="school-card-copy">
                {profile.parentLikes.length > 0 ? (
                  <ul>
                    {profile.parentLikes.map((item: string) => <li>{item}</li>)}
                  </ul>
                ) : (
                  <p>Coming soon</p>
                )}
              </div>
            </div>
          </article>

          {profile.content?.inspection_snapshot || profile.school.inspection_rating ? (
            <article class="school-feature-tile" data-school-mobile-section="about">
              <h2>Inspection snapshot</h2>
              <div class="school-feature-body">
                <div class="school-card-copy">
                  {profile.inspectionBullets.length > 1 ? (
                    <ul>
                      {profile.inspectionBullets.map((item: string) => <li>{item}</li>)}
                    </ul>
                  ) : (
                    splitParagraphs(profile.content?.inspection_snapshot || profile.school.inspection_rating).map((paragraph: string) => <p>{paragraph}</p>)
                  )}
                </div>
              </div>
            </article>
          ) : null}

          <article class="school-feature-tile school-feature-tile--cta school-desktop-only">
            <h2>For schools</h2>
            <div class="school-feature-body">
              <div class="school-card-copy">
                <p>School staff? Join us and improve this profile.</p>
                <p>Upload official imagery, add your website and admissions links, and choose a school-supported membership package.</p>
              </div>
              <a class="button-outline school-feature-tile__cta" href={`/claim-your-profile/?school=${profile.school.id}`}>Go to the school portal</a>
            </div>
          </article>
        </div>
      </section>

      <aside class="location-map-panel school-map-panel" data-school-mobile-section="overview">
        <div class="location-map-head">
          <p class="nav-kicker">Map</p>
          <h2>School location</h2>
        </div>
        <div aria-label={`Map showing ${profile.school.name}`} class="bath-location-map school-page-map" id="school-page-map"></div>
        <p class="map-caption">{profile.address}</p>
        <div class="school-map-actions school-desktop-only">
          {profile.parentLocationHref ? <a class="school-map-action school-map-action--secondary" data-restore-search-link href={profile.changeSearchHref}>Back to search results</a> : null}
          <a class="school-map-action school-map-action--primary" href={profile.changeSearchHref}>Change search area</a>
        </div>
      </aside>
    </div>
  </main>

  <SiteFooter />

  <script is:inline set:html={schoolMapScript}></script>
  <script is:inline set:html={schoolNearbyMapScript}></script>
  <script id="school-map-data" is:inline set:html={schoolMapJson} type="application/json"></script>
  <script id="school-nearby-map-data" is:inline set:html={schoolNearbyMapJson} type="application/json"></script>
  <script defer src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js" integrity="sha256-20nQCchB9co0qIjJZRGuk2/Z9VM+kNiyxNV1lvTlZBo=" crossorigin=""></script>
  <script defer src="https://unpkg.com/maplibre-gl@5.21.1/dist/maplibre-gl.js" crossorigin=""></script>
  <script defer src="https://unpkg.com/@maplibre/maplibre-gl-leaflet@0.1.3/leaflet-maplibre-gl.js" crossorigin=""></script>
  <script defer src="/assets/js/school-pages.js?v=20260418a-mobile-redesign"></script>
</BaseLayout>
