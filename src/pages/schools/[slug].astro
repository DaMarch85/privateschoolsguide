---
import SchoolProfilePage from '../../components/SchoolProfilePage.astro';
import {
  getAllCanonicalSchoolPaths,
  getCanonicalSchoolProfile
} from '../../lib/directory';

export async function getStaticPaths() {
  return await getAllCanonicalSchoolPaths();
}

const { slug } = Astro.params;
if (!slug) throw new Error('Missing school slug');

const profile = await getCanonicalSchoolProfile(slug);
---
<SchoolProfilePage
  canonicalPath={profile.canonicalPath}
  description={profile.subhead}
  profile={profile}
  title={`${profile.school.name} | ${profile.location.name} school profile`}
/>
