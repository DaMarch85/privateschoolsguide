---
import BaseLayout from '../layouts/BaseLayout.astro';
import SiteFooter from '../components/SiteFooter.astro';
import { supabase } from '../lib/supabase';
import { getHomepageSearchSchools } from '../lib/directory';
import { getLocationPresentation } from '../lib/location-config';

type HomepageLocationRow = {
  name: string;
  slug: string;
  homepage_order: number | null;
};

const { data: homepageLocationsRaw, error: homepageLocationsError } = await supabase
  .from('locations')
  .select('name, slug, homepage_order')
  .eq('is_live', true)
  .eq('show_on_homepage', true)
  .order('homepage_order', { ascending: true, nullsFirst: false })
  .order('name', { ascending: true });

if (homepageLocationsError) {
  throw new Error(`Could not load homepage locations: ${homepageLocationsError.message}`);
}

const homepageLocations = (homepageLocationsRaw || []) as HomepageLocationRow[];

const locations = homepageLocations.map((location) => {
  const presentation = getLocationPresentation(location.slug, location.name);
  const subtitle = presentation.heroSubtitle;

  return {
    name: location.name,
    href: `/${location.slug}/`,
    subtitle,
    searchText: [location.name, subtitle].filter(Boolean).join(' ')
  };
}).sort((a, b) => a.name.localeCompare(b.name, 'en'));

const homepageSchools = await getHomepageSearchSchools();
const initialSchoolCount = new Intl.NumberFormat('en-GB').format(homepageSchools.length);
const religionSortOrder = [
  'Church of England',
  'Christian',
  'Roman Catholic',
  'Jewish',
  'Muslim',
  'Non-denominational',
  'Multi-faith',
  'Methodist',
  'Plymouth Brethren Christian Church',
  'Quaker',
  'Seventh-day Adventist',
  'Hindu',
  'Sikh',
  'United Reformed Church'
];
const religionOptions = Array.from(new Set(homepageSchools.map((school) => school.religion).filter(Boolean) as string[]))
  .sort((a, b) => {
    const aIndex = religionSortOrder.indexOf(a);
    const bIndex = religionSortOrder.indexOf(b);
    const safeA = aIndex === -1 ? Number.MAX_SAFE_INTEGER : aIndex;
    const safeB = bIndex === -1 ? Number.MAX_SAFE_INTEGER : bIndex;
    if (safeA !== safeB) return safeA - safeB;
    return a.localeCompare(b, 'en');
  });

const genderOptions = [
  { value: 'boys', label: 'Boys only' },
  { value: 'girls', label: 'Girls only' },
  { value: 'mixed', label: 'Co-educational' }
];

const ageRangeOptions = [
  { value: 'preprep', label: 'Pre-prep (ages 3–7)' },
  { value: 'prep', label: 'Prep (ages 7–11)' },
  { value: 'senior', label: 'Senior (ages 13–18)' }
];

const boardingOptions = [
  { value: 'dayProvision', label: 'Day provision' },
  { value: 'boardingProvision', label: 'Boarding provision' }
];

const homepageSchoolSearchScript = `window.homepageSchoolSearchData = ${JSON.stringify(homepageSchools)};`;
---
<BaseLayout
  title="The Private School Guide"
  description="Search private schools by UK location, distance and core filters."
  canonicalPath="/"
  includeLeaflet={true}
  bodyClass="home-minimal"
>
  <Fragment slot="head">
    <link rel="stylesheet" href="/assets/css/homepage.css?v=20260414d-range-row" />
    <link rel="stylesheet" href="/assets/css/mobile-redesign.css?v=20260418b-mobile-compact" />
  </Fragment>

  <main id="main">
    <section aria-labelledby="home-title" class="home-hero" data-home-hero>
      <video autoplay class="hero-video hero-video-desktop" data-home-hero-video muted playsinline poster="/assets/video/home-hero-poster.jpg" preload="metadata">
        <source src="/assets/video/home-hero-desktop.mp4" type="video/mp4" />
      </video>
      <video autoplay class="hero-video hero-video-mobile" data-home-hero-video muted playsinline poster="/assets/video/home-hero-mobile-poster.jpg" preload="metadata">
        <source src="/assets/video/home-hero-mobile.mp4" type="video/mp4" />
      </video>
      <div aria-hidden="true" class="hero-wash"></div>
      <div class="hero-centre shell">
        <h1 class="hero-title" id="home-title">
          <span>THE</span>
          <span>PRIVATE SCHOOL</span>
          <span>GUIDE</span>
        </h1>
      </div>
    </section>

    <section class="home-mobile-intro shell" aria-label="Mobile search intro">
      <div class="home-mobile-intro__copy">
        <h2 class="home-mobile-intro__title">Search by town or postcode and filters</h2>
      </div>
    </section>

    <section aria-labelledby="school-filter-title" class="home-school-filter-bar">
      <div class="shell">
        <h2 class="visually-hidden" id="school-filter-title">School filters</h2>

        <form class="school-filter-form school-filter-form--desktop" id="homepage-school-filters-desktop" data-filter-variant="desktop" novalidate>
          <div class="school-filter-mobile-actions">
            <button aria-controls="homepage-school-filter-collapsible-desktop" aria-expanded="true" class="school-filter-mobile-button" data-filter-toggle type="button">Hide filters</button>
          </div>

          <div class="school-filter-collapsible" data-filter-collapsible id="homepage-school-filter-collapsible-desktop">
          <div class="school-filter-grid">
            <div class="school-filter-field school-filter-field--location">
              <label class="school-filter-label" for="school-filter-location">Location</label>
              <input
                autocomplete="postal-code"
                class="school-filter-input"
                id="school-filter-location" data-filter-location
                name="location"
                placeholder="Postcode or UK location"
                type="text"
              />
            </div>

            <div class="school-filter-field school-filter-field--radius">
              <label class="school-filter-label" for="school-filter-radius">Radius (miles)</label>
              <input class="school-filter-input" id="school-filter-radius" data-filter-radius min="1" name="radius" step="1" type="number" value="10" />
            </div>

            <div class="school-filter-field school-filter-field--compact">
              <span class="school-filter-label">Gender</span>
              <details class="school-filter-dropdown" data-dropdown>
                <summary class="school-filter-dropdown__summary">
                  <span class="school-filter-dropdown__value" data-default-label="Any" data-dropdown-value>Any</span>
                </summary>
                <div class="school-filter-dropdown__panel">
                  <div class="school-filter-options school-filter-options--stacked">
                    {genderOptions.map((option) => (
                      <label class="school-filter-option school-filter-option--dropdown">
                        <input data-option-label={option.label} name="gender" type="checkbox" value={option.value} />
                        <span>{option.label}</span>
                      </label>
                    ))}
                  </div>
                </div>
              </details>
            </div>

            <div class="school-filter-field school-filter-field--compact">
              <span class="school-filter-label">Age range</span>
              <details class="school-filter-dropdown" data-dropdown>
                <summary class="school-filter-dropdown__summary">
                  <span class="school-filter-dropdown__value" data-default-label="Any" data-dropdown-value>Any</span>
                </summary>
                <div class="school-filter-dropdown__panel">
                  <div class="school-filter-options school-filter-options--stacked">
                    {ageRangeOptions.map((option) => (
                      <label class="school-filter-option school-filter-option--dropdown">
                        <input data-option-label={option.label} name="ageRange" type="checkbox" value={option.value} />
                        <span>{option.label}</span>
                      </label>
                    ))}
                  </div>
                </div>
              </details>
            </div>

            <div class="school-filter-field school-filter-field--compact">
              <span class="school-filter-label">Boarding</span>
              <details class="school-filter-dropdown" data-dropdown>
                <summary class="school-filter-dropdown__summary">
                  <span class="school-filter-dropdown__value" data-default-label="Any" data-dropdown-value>Any</span>
                </summary>
                <div class="school-filter-dropdown__panel">
                  <div class="school-filter-options school-filter-options--stacked">
                    {boardingOptions.map((option) => (
                      <label class="school-filter-option school-filter-option--dropdown">
                        <input data-option-label={option.label} name="boarding" type="checkbox" value={option.value} />
                        <span>{option.label}</span>
                      </label>
                    ))}
                  </div>
                </div>
              </details>
            </div>

            <div class="school-filter-field school-filter-field--compact school-filter-field--religion">
              <span class="school-filter-label">Religion</span>
              <details class="school-filter-dropdown school-filter-dropdown--wide" data-dropdown>
                <summary class="school-filter-dropdown__summary">
                  <span class="school-filter-dropdown__value" data-default-label="Any" data-dropdown-value>Any</span>
                </summary>
                <div class="school-filter-dropdown__panel school-filter-dropdown__panel--religion">
                  <div class="school-filter-options school-filter-options--grid">
                    {religionOptions.map((religion) => (
                      <label class="school-filter-option school-filter-option--dropdown">
                        <input data-option-label={religion} name="religion" type="checkbox" value={religion} />
                        <span>{religion}</span>
                      </label>
                    ))}
                  </div>
                </div>
              </details>
            </div>

            <div class="school-filter-range-row">
              <div class="school-filter-field school-filter-field--range school-filter-field--day-fee">
                <span class="school-filter-label">Average day fees</span>
                <div class="school-range-filter school-range-filter--fee" data-day-fee-filter>
                  <p class="school-range-filter__count" data-day-fee-histogram-count>Loading day-fee data…</p>
                  <div aria-hidden="true" class="school-range-filter__histogram" data-day-fee-histogram></div>
                  <div class="school-range-filter__slider-wrap">
                    <input class="school-range-filter__slider" data-day-fee-min id="school-filter-day-fee-min" type="range" />
                    <input class="school-range-filter__slider" data-day-fee-max id="school-filter-day-fee-max" type="range" />
                  </div>
                  <div class="school-range-filter__display">
                    <div class="school-range-filter__display-box">
                      <span class="school-range-filter__display-label">Minimum</span>
                      <strong data-day-fee-min-display>£1,000</strong>
                    </div>
                    <div class="school-range-filter__display-box">
                      <span class="school-range-filter__display-label">Maximum</span>
                      <strong data-day-fee-max-display>£0</strong>
                    </div>
                  </div>
                </div>
              </div>

              <div class="school-filter-field school-filter-field--range school-filter-field--boarding-fee">
                <span class="school-filter-label">Average boarding fees</span>
                <div class="school-range-filter school-range-filter--fee" data-boarding-fee-filter>
                  <p class="school-range-filter__count" data-boarding-fee-histogram-count>Loading boarding-fee data…</p>
                  <div aria-hidden="true" class="school-range-filter__histogram" data-boarding-fee-histogram></div>
                  <div class="school-range-filter__slider-wrap">
                    <input class="school-range-filter__slider" data-boarding-fee-min id="school-filter-boarding-fee-min" type="range" />
                    <input class="school-range-filter__slider" data-boarding-fee-max id="school-filter-boarding-fee-max" type="range" />
                  </div>
                  <div class="school-range-filter__display">
                    <div class="school-range-filter__display-box">
                      <span class="school-range-filter__display-label">Minimum</span>
                      <strong data-boarding-fee-min-display>£1,000</strong>
                    </div>
                    <div class="school-range-filter__display-box">
                      <span class="school-range-filter__display-label">Maximum</span>
                      <strong data-boarding-fee-max-display>£0</strong>
                    </div>
                  </div>
                </div>
              </div>

              <div class="school-filter-field school-filter-field--range school-filter-field--alevel">
                <span class="school-filter-label">A*–A at A-level</span>
                <div class="school-range-filter school-range-filter--alevel" data-alevel-filter>
                  <p class="school-range-filter__count" data-alevel-histogram-count>Loading A-level data…</p>
                  <div aria-hidden="true" class="school-range-filter__histogram" data-alevel-histogram></div>
                  <div class="school-range-filter__slider-wrap">
                    <input class="school-range-filter__slider" data-alevel-min id="school-filter-alevel-min" type="range" />
                    <input class="school-range-filter__slider" data-alevel-max id="school-filter-alevel-max" type="range" />
                  </div>
                  <div class="school-range-filter__display">
                    <div class="school-range-filter__display-box">
                      <span class="school-range-filter__display-label">Minimum</span>
                      <strong data-alevel-min-display>0%</strong>
                    </div>
                    <div class="school-range-filter__display-box">
                      <span class="school-range-filter__display-label">Maximum</span>
                      <strong data-alevel-max-display>100%</strong>
                    </div>
                  </div>
                </div>
              </div>
            </div>

            <div class="school-filter-field school-filter-field--must-have">
              <span class="school-filter-label">Must have</span>
              <div class="school-filter-checklist">
                <label class="school-filter-check">
                  <input id="school-filter-sixth-form" data-filter-sixth-form name="sixthForm" type="checkbox" />
                  <span>Sixth form</span>
                </label>
                <label class="school-filter-check">
                  <input id="school-filter-nursery" data-filter-nursery name="nursery" type="checkbox" />
                  <span>Nursery</span>
                </label>
                <label class="school-filter-check">
                  <input id="school-filter-bursaries" data-filter-bursaries name="bursaries" type="checkbox" />
                  <span>Bursaries available</span>
                </label>
                <label class="school-filter-check">
                  <input id="school-filter-scholarships" data-filter-scholarships name="scholarships" type="checkbox" />
                  <span>Scholarships available</span>
                </label>
              </div>
            </div>
          </div>

          <div class="school-filter-actions">
            <p aria-live="polite" class="school-filter-error" hidden id="homepage-school-filter-error" data-filter-error></p>
            <div class="school-filter-button-row">
              <button class="school-filter-reset" id="homepage-school-filter-reset" data-filter-reset type="button">Clear filters</button>
            </div>
          </div>
          </div>
        </form>
      

<form class="school-filter-form school-filter-form--mobile" id="homepage-school-filters-mobile" data-filter-variant="mobile" novalidate>
          <div class="school-filter-grid school-filter-grid--mobile-compact">
            <div class="school-filter-field school-filter-field--location">
              <label class="visually-hidden" for="school-filter-location-mobile">Town or postcode</label>
              <input
                autocomplete="postal-code"
                class="school-filter-input"
                id="school-filter-location-mobile" data-filter-location
                name="location"
                placeholder="Enter postcode or town location"
                type="text"
              />
            </div>

            <div class="school-filter-field school-filter-field--distance">
              <span class="visually-hidden">Distance in miles</span>
              <input id="school-filter-radius-mobile" data-filter-radius name="radius" type="hidden" value="5" />
              <div aria-label="Distance in miles" class="school-filter-chip-group school-filter-chip-group--distance" data-radius-group role="group">
                <button class="school-filter-chip" data-radius-option data-value="2" type="button">2</button>
                <button class="school-filter-chip is-active" data-radius-option data-value="5" type="button">5</button>
                <button class="school-filter-chip" data-radius-option data-value="10" type="button">10</button>
                <button class="school-filter-chip" data-radius-option data-value="25" type="button">25</button>
                <button class="school-filter-chip" data-radius-option data-value="50" type="button">50</button>
                <button class="school-filter-chip" data-radius-option data-value="100" type="button">100</button>
                <button class="school-filter-chip" data-radius-option data-value="all" type="button">All</button>
              </div>
            </div>

            <div class="school-filter-field school-filter-field--half school-filter-field--gender school-filter-field--panel-left">
              <details class="school-filter-dropdown" data-dropdown>
                <summary class="school-filter-dropdown__summary school-filter-dropdown__summary--compact">
                  <span
                    class="school-filter-dropdown__value"
                    data-default-label="Any"
                    data-dropdown-value
                    data-filter-label="Gender"
                  >Gender: Any</span>
                </summary>
                <div class="school-filter-dropdown__panel">
                  <div class="school-filter-options school-filter-options--stacked">
                    <label class="school-filter-option school-filter-option--dropdown">
                      <input checked data-option-label="Any" name="gender" type="radio" value="" />
                      <span>Any</span>
                    </label>
                    {genderOptions.map((option) => (
                      <label class="school-filter-option school-filter-option--dropdown">
                        <input data-option-label={option.label} name="gender" type="radio" value={option.value} />
                        <span>{option.label}</span>
                      </label>
                    ))}
                  </div>
                </div>
              </details>
            </div>

            <div class="school-filter-field school-filter-field--half school-filter-field--boarding-toggle">
              <label class="visually-hidden" for="school-filter-boarding-mode-mobile">Day or boarding</label>
              <input id="school-filter-boarding-mode-mobile" data-filter-boarding-mode name="boardingMode" type="hidden" value="dayProvision" />
              <div aria-label="Day or boarding" class="school-filter-segmented" role="group">
                <button class="school-filter-segmented__button is-active" data-boarding-option data-value="dayProvision" type="button">Day</button>
                <button class="school-filter-segmented__button" data-boarding-option data-value="boardingProvision" type="button">Boarding</button>
              </div>
            </div>

            <div class="school-filter-field school-filter-field--half school-filter-field--age school-filter-field--panel-left">
              <details class="school-filter-dropdown" data-dropdown>
                <summary class="school-filter-dropdown__summary school-filter-dropdown__summary--compact">
                  <span
                    class="school-filter-dropdown__value"
                    data-default-label="Any"
                    data-dropdown-value
                    data-filter-label="Age range"
                  >Age range: Any</span>
                </summary>
                <div class="school-filter-dropdown__panel school-filter-dropdown__panel--double">
                  <div class="school-filter-options school-filter-options--stacked">
                    {ageRangeOptions.map((option) => (
                      <label class="school-filter-option school-filter-option--dropdown">
                        <input data-option-label={option.label} name="ageRange" type="checkbox" value={option.value} />
                        <span>{option.label}</span>
                      </label>
                    ))}
                  </div>
                </div>
              </details>
            </div>

            <div class="school-filter-field school-filter-field--half school-filter-field--religion school-filter-field--panel-right">
              <details class="school-filter-dropdown" data-dropdown>
                <summary class="school-filter-dropdown__summary school-filter-dropdown__summary--compact">
                  <span
                    class="school-filter-dropdown__value"
                    data-default-label="Any"
                    data-dropdown-value
                    data-filter-label="Religion"
                  >Religion: Any</span>
                </summary>
                <div class="school-filter-dropdown__panel school-filter-dropdown__panel--religion school-filter-dropdown__panel--double">
                  <div class="school-filter-options school-filter-options--grid">
                    {religionOptions.map((religion) => (
                      <label class="school-filter-option school-filter-option--dropdown">
                        <input data-option-label={religion} name="religion" type="checkbox" value={religion} />
                        <span>{religion}</span>
                      </label>
                    ))}
                  </div>
                </div>
              </details>
            </div>

            <div class="school-filter-field school-filter-field--range school-filter-field--day-fee" data-fee-panel="day">
              <div class="school-range-filter school-range-filter--fee school-range-filter--compact" data-day-fee-filter>
                <div class="school-range-filter__header">
                  <span class="school-range-filter__title">Day fees</span>
                  <span class="school-range-filter__value-pair">
                    <strong data-day-fee-min-display>£1,000</strong>
                    <span>–</span>
                    <strong data-day-fee-max-display>£0</strong>
                  </span>
                </div>
                <div class="school-range-filter__slider-wrap">
                  <input class="school-range-filter__slider" data-day-fee-min id="school-filter-day-fee-min-mobile" type="range" />
                  <input class="school-range-filter__slider" data-day-fee-max id="school-filter-day-fee-max-mobile" type="range" />
                </div>
              </div>
            </div>

            <div class="school-filter-field school-filter-field--range school-filter-field--boarding-fee" data-fee-panel="boarding">
              <div class="school-range-filter school-range-filter--fee school-range-filter--compact" data-boarding-fee-filter>
                <div class="school-range-filter__header">
                  <span class="school-range-filter__title">Boarding fees</span>
                  <span class="school-range-filter__value-pair">
                    <strong data-boarding-fee-min-display>£1,000</strong>
                    <span>–</span>
                    <strong data-boarding-fee-max-display>£0</strong>
                  </span>
                </div>
                <div class="school-range-filter__slider-wrap">
                  <input class="school-range-filter__slider" data-boarding-fee-min id="school-filter-boarding-fee-min-mobile" type="range" />
                  <input class="school-range-filter__slider" data-boarding-fee-max id="school-filter-boarding-fee-max-mobile" type="range" />
                </div>
              </div>
            </div>

            <div class="school-filter-field school-filter-field--range school-filter-field--alevel" data-conditional-alevel>
              <div class="school-range-filter school-range-filter--alevel school-range-filter--compact" data-alevel-filter>
                <div class="school-range-filter__header">
                  <span class="school-range-filter__title">A*–A at A-level</span>
                  <span class="school-range-filter__value-pair">
                    <strong data-alevel-min-display>0%</strong>
                    <span>–</span>
                    <strong data-alevel-max-display>100%</strong>
                  </span>
                </div>
                <div class="school-range-filter__slider-wrap">
                  <input class="school-range-filter__slider" data-alevel-min id="school-filter-alevel-min-mobile" type="range" />
                  <input class="school-range-filter__slider" data-alevel-max id="school-filter-alevel-max-mobile" type="range" />
                </div>
              </div>
            </div>

            <div class="school-filter-field school-filter-field--must-have school-filter-field--must-have-inline">
              <div class="school-filter-checklist school-filter-checklist--inline">
                <span class="school-filter-checklist__label">Must have</span>
                <label class="school-filter-check">
                  <input id="school-filter-sixth-form-mobile" data-filter-sixth-form name="sixthForm" type="checkbox" />
                  <span>Sixth form</span>
                </label>
                <label class="school-filter-check">
                  <input id="school-filter-nursery-mobile" data-filter-nursery name="nursery" type="checkbox" />
                  <span>Nursery</span>
                </label>
              </div>
            </div>
          </div>

          <div class="school-filter-actions school-filter-actions--compact">
            <p aria-live="polite" class="school-filter-error" hidden id="homepage-school-filter-error-mobile" data-filter-error></p>
            <div class="school-filter-button-row school-filter-button-row--single">
              <button class="school-filter-open-first school-filter-open-first--full" data-open-first-result type="button">Show schools</button>
            </div>
          </div>
        </form>
      </div>
    </section>

    <section aria-labelledby="finder-title" class="home-finder shell">
      <h2 class="visually-hidden" id="finder-title">Find schools and locations</h2>
      <div class="finder-grid">
        <div class="finder-left-column">
          <div class="finder-left-inner">
            <div class="finder-panel finder-map-panel">
              <div class="finder-results-head finder-results-head--map">
                <div>
                  <h3 class="finder-results-title">School locations</h3>
                </div>
              </div>
              <div aria-label="Private school map" class="homepage-map" id="homepage-map"></div>
              <p class="finder-note" id="homepage-map-empty" hidden>School locations are being updated.</p>
            </div>

            <div class="finder-panel finder-locations">
              <div class="finder-locations-head">
                <div>
                  <h3 class="finder-results-title">Browse locations</h3>
                </div>
                <button class="finder-locations-toggle" data-location-toggle aria-controls="guide-location-panel" aria-expanded="true" type="button">Hide locations</button>
              </div>
              <div class="finder-locations-body" data-location-panel id="guide-location-panel">
                <label class="visually-hidden" for="guide-location-search">Search location guides</label>
                <input autocomplete="off" class="location-search" id="guide-location-search" placeholder="Browse locations" type="search" />
                <ul class="location-list" id="guide-location-list">
                  {locations.map((location) => (
                    <li>
                      <a class="location-link is-live" data-location-item data-name={location.name} data-search={location.searchText} href={location.href}>
                        <span class="location-name">{location.name}</span>
                        <span class="location-state">{location.subtitle || 'Private school guide'}</span>
                      </a>
                    </li>
                  ))}
                </ul>
              </div>
            </div>
          </div>
        </div>

        <div class="finder-panel finder-cards-panel" data-mobile-results-panel id="homepage-results-panel">
          <div class="finder-results-head finder-results-head--results">
            <div>
              <h2 class="finder-results-title">Schools</h2>
            </div>
            <button class="homepage-results-close" data-hide-full-results type="button">Back to filters</button>
            <p aria-live="polite" class="finder-results-summary" id="homepage-results-summary">Showing all {initialSchoolCount} schools with map coordinates.</p>
          </div>

          <div class="homepage-results-toolbar">
            <div class="homepage-view-toggle" role="tablist" aria-label="Homepage result view">
              <button class="homepage-view-button is-active" data-result-view="tiles" type="button">Schools</button>
              <button class="homepage-view-button" data-result-view="glance" type="button">At a glance</button>
              <button class="homepage-view-button" data-result-view="dayFees" type="button">Day fees</button>
              <button class="homepage-view-button" data-result-view="boardingFees" type="button">Boarding fees</button>
              <button class="homepage-view-button" data-result-view="alevel" type="button">A-levels</button>
            </div>

            <div class="homepage-sort-controls">
              <label class="homepage-sort-label" for="homepage-school-sort">Sort by</label>
              <select class="homepage-sort-select" id="homepage-school-sort">
                <option value="az">A–Z</option>
                <option selected value="dayFeesDesc">Day fees: high to low</option>
                <option value="dayFeesAsc">Day fees: low to high</option>
                <option value="boardingFeesDesc">Boarding fees: high to low</option>
                <option value="boardingFeesAsc">Boarding fees: low to high</option>
              </select>
            </div>

            <a class="homepage-shortlist-link" href="/shortlist/">
              View shortlist
              <span class="homepage-shortlist-link__count" data-shortlist-count>0</span>
            </a>

            <div class="homepage-table-controls" id="homepage-table-controls" hidden>
              <div class="homepage-table-nav">
                <button class="homepage-table-nav__button" id="homepage-table-prev" type="button" aria-label="Previous schools">←</button>
                <p class="homepage-table-nav__label" id="homepage-table-page-label">Schools 1–6</p>
                <button class="homepage-table-nav__button" id="homepage-table-next" type="button" aria-label="Next schools">→</button>
                <button class="homepage-table-show-all" id="homepage-table-show-all" type="button">Show all</button>
              </div>
            </div>
          </div>

          <div class="homepage-visible-school-grid" id="homepage-visible-school-grid"></div>
          <div class="homepage-school-table-wrap" id="homepage-school-table-wrap" hidden>
            <div class="homepage-school-table-scroll">
              <table class="homepage-school-table" id="homepage-school-table"></table>
            </div>
          </div>
          <p class="finder-note" id="homepage-visible-school-empty" hidden>No schools are currently visible on the map.</p>
        </div>
      </div>
    </section>
  </main>

  <SiteFooter full={true} />

  <script is:inline set:html={homepageSchoolSearchScript}></script>
  <script defer src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js" integrity="sha256-20nQCchB9co0qIjJZRGuk2/Z9VM+kNiyxNV1lvTlZBo=" crossorigin=""></script>
  <script defer src="https://unpkg.com/maplibre-gl@5.21.1/dist/maplibre-gl.js" crossorigin=""></script>
  <script defer src="https://unpkg.com/@maplibre/maplibre-gl-leaflet@0.1.3/leaflet-maplibre-gl.js" crossorigin=""></script>
  <script defer src="/assets/js/homepage.js?v=20260418b-mobile-compact"></script>
</BaseLayout>
