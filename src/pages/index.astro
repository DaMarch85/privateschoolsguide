---
import BaseLayout from '../layouts/BaseLayout.astro';
import SiteFooter from '../components/SiteFooter.astro';
import { supabase } from '../lib/supabase';
import { getHomepageSearchSchools } from '../lib/directory';
import { getLocationPresentation } from '../lib/location-config';

type HomepageLocationRow = {
  name: string;
  slug: string;
  homepage_order: number | null;
};

const { data: homepageLocationsRaw, error: homepageLocationsError } = await supabase
  .from('locations')
  .select('name, slug, homepage_order')
  .eq('is_live', true)
  .eq('show_on_homepage', true)
  .order('homepage_order', { ascending: true, nullsFirst: false })
  .order('name', { ascending: true });

if (homepageLocationsError) {
  throw new Error(`Could not load homepage locations: ${homepageLocationsError.message}`);
}

const homepageLocations = (homepageLocationsRaw || []) as HomepageLocationRow[];

const locations = homepageLocations.map((location) => {
  const presentation = getLocationPresentation(location.slug, location.name);
  const subtitle = presentation.heroSubtitle;

  return {
    name: location.name,
    href: `/${location.slug}/`,
    subtitle,
    searchText: [location.name, subtitle].filter(Boolean).join(' ')
  };
});

const homepageSchools = await getHomepageSearchSchools();
const initialSchoolCount = new Intl.NumberFormat('en-GB').format(homepageSchools.length);
const religionSortOrder = [
  'Church of England',
  'Christian',
  'Roman Catholic',
  'Jewish',
  'Muslim',
  'Non-denominational',
  'Multi-faith',
  'Methodist',
  'Plymouth Brethren Christian Church',
  'Quaker',
  'Seventh-day Adventist',
  'Hindu',
  'Sikh',
  'United Reformed Church'
];
const religionOptions = Array.from(new Set(homepageSchools.map((school) => school.religion).filter(Boolean) as string[]))
  .sort((a, b) => {
    const aIndex = religionSortOrder.indexOf(a);
    const bIndex = religionSortOrder.indexOf(b);
    const safeA = aIndex === -1 ? Number.MAX_SAFE_INTEGER : aIndex;
    const safeB = bIndex === -1 ? Number.MAX_SAFE_INTEGER : bIndex;
    if (safeA !== safeB) return safeA - safeB;
    return a.localeCompare(b, 'en');
  });

const genderOptions = [
  { value: 'boys', label: 'Boys' },
  { value: 'girls', label: 'Girls' },
  { value: 'mixed', label: 'Mixed' }
];

const boardingOptions = [
  { value: 'day', label: 'Day only' },
  { value: 'boarding', label: 'Boarding only' },
  { value: 'both', label: 'Both' }
];

const homepageSchoolSearchScript = `window.homepageSchoolSearchData = ${JSON.stringify(homepageSchools)};`;
---
<BaseLayout
  title="The Private School Guide"
  description="Search private schools by UK location, distance and core filters."
  canonicalPath="/"
  includeLeaflet={true}
  bodyClass="home-minimal"
>
  <Fragment slot="head">
    <link rel="stylesheet" href="/assets/css/homepage.css" />
  </Fragment>

  <main id="main">
    <section aria-labelledby="home-title" class="home-hero">
      <video autoplay class="hero-video hero-video-desktop" loop muted playsinline poster="/assets/video/home-hero-poster.jpg" preload="metadata">
        <source src="/assets/video/home-hero-desktop.mp4" type="video/mp4" />
      </video>
      <video autoplay class="hero-video hero-video-mobile" loop muted playsinline poster="/assets/video/home-hero-mobile-poster.jpg" preload="metadata">
        <source src="/assets/video/home-hero-mobile.mp4" type="video/mp4" />
      </video>
      <div aria-hidden="true" class="hero-wash"></div>
      <div class="hero-centre shell">
        <h1 class="hero-title" id="home-title">
          <span>THE</span>
          <span>PRIVATE SCHOOL</span>
          <span>GUIDE</span>
        </h1>
      </div>
    </section>

    <section aria-labelledby="school-filter-title" class="home-school-filter-bar">
      <div class="shell">
        <form class="school-filter-form" id="homepage-school-filters" novalidate>
          <h2 class="visually-hidden" id="school-filter-title">School filters</h2>

          <div class="school-filter-grid">
            <div class="school-filter-field school-filter-field--location">
              <label class="school-filter-label" for="school-filter-location">Location</label>
              <input
                autocomplete="postal-code"
                class="school-filter-input"
                id="school-filter-location"
                name="location"
                placeholder="Postcode or UK location"
                type="text"
              />
            </div>

            <div class="school-filter-field school-filter-field--radius">
              <label class="school-filter-label" for="school-filter-radius">Radius (miles)</label>
              <input class="school-filter-input" id="school-filter-radius" min="1" name="radius" step="1" type="number" value="10" />
            </div>

            <div class="school-filter-field school-filter-field--compact">
              <span class="school-filter-label">Gender</span>
              <details class="school-filter-dropdown" data-dropdown>
                <summary class="school-filter-dropdown__summary">
                  <span class="school-filter-dropdown__value" data-default-label="Any" data-dropdown-value>Any</span>
                </summary>
                <div class="school-filter-dropdown__panel">
                  <div class="school-filter-options school-filter-options--stacked">
                    {genderOptions.map((option) => (
                      <label class="school-filter-option school-filter-option--dropdown">
                        <input data-option-label={option.label} name="gender" type="checkbox" value={option.value} />
                        <span>{option.label}</span>
                      </label>
                    ))}
                  </div>
                </div>
              </details>
            </div>

            <div class="school-filter-field school-filter-field--compact">
              <span class="school-filter-label">Boarding</span>
              <details class="school-filter-dropdown" data-dropdown>
                <summary class="school-filter-dropdown__summary">
                  <span class="school-filter-dropdown__value" data-default-label="Any" data-dropdown-value>Any</span>
                </summary>
                <div class="school-filter-dropdown__panel">
                  <div class="school-filter-options school-filter-options--stacked">
                    {boardingOptions.map((option) => (
                      <label class="school-filter-option school-filter-option--dropdown">
                        <input data-option-label={option.label} name="boarding" type="checkbox" value={option.value} />
                        <span>{option.label}</span>
                      </label>
                    ))}
                  </div>
                </div>
              </details>
            </div>

            <div class="school-filter-field school-filter-field--compact">
              <span class="school-filter-label">Includes</span>
              <details class="school-filter-dropdown" data-dropdown>
                <summary class="school-filter-dropdown__summary">
                  <span class="school-filter-dropdown__value" data-default-label="Any" data-dropdown-value>Any</span>
                </summary>
                <div class="school-filter-dropdown__panel">
                  <div class="school-filter-options school-filter-options--stacked">
                    <label class="school-filter-option school-filter-option--dropdown">
                      <input data-option-label="Sixth form" id="school-filter-sixth-form" name="sixthForm" type="checkbox" />
                      <span>Sixth form</span>
                    </label>
                    <label class="school-filter-option school-filter-option--dropdown">
                      <input data-option-label="Nursery" id="school-filter-nursery" name="nursery" type="checkbox" />
                      <span>Nursery</span>
                    </label>
                  </div>
                </div>
              </details>
            </div>

            <div class="school-filter-field school-filter-field--compact school-filter-field--religion">
              <span class="school-filter-label">Religion</span>
              <details class="school-filter-dropdown school-filter-dropdown--wide" data-dropdown>
                <summary class="school-filter-dropdown__summary">
                  <span class="school-filter-dropdown__value" data-default-label="Any" data-dropdown-value>Any</span>
                </summary>
                <div class="school-filter-dropdown__panel school-filter-dropdown__panel--religion">
                  <div class="school-filter-options school-filter-options--grid">
                    {religionOptions.map((religion) => (
                      <label class="school-filter-option school-filter-option--dropdown">
                        <input data-option-label={religion} name="religion" type="checkbox" value={religion} />
                        <span>{religion}</span>
                      </label>
                    ))}
                  </div>
                </div>
              </details>
            </div>
          </div>

          <div class="school-filter-actions">
            <p aria-live="polite" class="school-filter-error" hidden id="homepage-school-filter-error"></p>

            <div class="school-filter-button-row">
              <button class="school-filter-submit" id="homepage-school-filter-submit" type="submit">Apply filters</button>
              <button class="school-filter-reset" id="homepage-school-filter-reset" type="button">Clear filters</button>
            </div>
          </div>
        </form>
      </div>
    </section>

    <section aria-labelledby="finder-title" class="home-finder shell">
      <h2 class="visually-hidden" id="finder-title">Find schools and locations</h2>
      <div class="finder-grid">
        <div class="finder-left-column">
          <div class="finder-left-inner">
            <div class="finder-panel finder-map-panel">
              <div class="finder-results-head finder-results-head--map">
                <div>
                  <p class="finder-kicker">Map</p>
                  <h3 class="finder-results-title">School locations</h3>
                </div>
              </div>
              <div aria-label="Private school map" class="homepage-map" id="homepage-map"></div>
              <p class="finder-note" id="homepage-map-empty" hidden>School locations are being updated.</p>
            </div>

            <div class="finder-panel finder-locations">
              <div class="finder-locations-head">
                <div>
                  <p class="finder-kicker">Live guides</p>
                  <h3 class="finder-results-title">Browse locations</h3>
                </div>
              </div>
              <label class="visually-hidden" for="guide-location-search">Search location guides</label>
              <input autocomplete="off" class="location-search" id="guide-location-search" placeholder="Browse live guides" type="search" />
              <ul class="location-list" id="guide-location-list">
                {locations.map((location) => (
                  <li>
                    <a class="location-link is-live" data-location-item data-name={location.name} data-search={location.searchText} href={location.href}>
                      <span class="location-name">{location.name}</span>
                      <span class="location-state">{location.subtitle || 'Private school guide'}</span>
                    </a>
                  </li>
                ))}
              </ul>
            </div>
          </div>
        </div>

        <div class="finder-panel finder-cards-panel">
          <div class="finder-results-head">
            <div>
              <p class="finder-kicker">School results</p>
              <h2 class="finder-results-title">Schools</h2>
            </div>
            <p aria-live="polite" class="finder-results-summary" id="homepage-results-summary">Showing all {initialSchoolCount} schools with map coordinates.</p>
          </div>
          <div class="homepage-visible-school-grid" id="homepage-visible-school-grid"></div>
          <p class="finder-note" id="homepage-visible-school-empty" hidden>No schools are currently visible on the map.</p>
        </div>
      </div>
    </section>
  </main>

  <SiteFooter full={true} />

  <script is:inline set:html={homepageSchoolSearchScript}></script>
  <script defer src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js" integrity="sha256-20nQCchB9co0qIjJZRGuk2/Z9VM+kNiyxNV1lvTlZBo=" crossorigin=""></script>
  <script defer src="/assets/js/homepage.js?v=20260325-homepage-school-filters"></script>
</BaseLayout>
