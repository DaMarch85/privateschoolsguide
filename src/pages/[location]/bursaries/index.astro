---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import SiteHeader from '../../../components/SiteHeader.astro';
import SiteFooter from '../../../components/SiteFooter.astro';
import LocationSideNav from '../../../components/LocationSideNav.astro';
import { getLocationBursariesData, getLocationPaths } from '../../../lib/directory';

export async function getStaticPaths() {
  return await getLocationPaths();
}

const { location: locationSlug } = Astro.params;
if (!locationSlug) throw new Error('Missing location slug');

const { location, cards } = await getLocationBursariesData(locationSlug);
const heroImage = '/assets/img/bath/bath-location-hero.jpg';
const title = `${location.name} private school bursaries | The Private School Guide`;
const description = `Parent-friendly bursary summaries for ${location.name} private schools.`;
---
<BaseLayout
  title={title}
  description={description}
  canonicalPath={`/${location.slug}/bursaries/`}
  bodyClass="location-page location-page--data"
  dataLocationSlug={location.slug}
>
  <Fragment slot="head">
    <link rel="stylesheet" href="/assets/css/styles.css" />
    <link rel="stylesheet" href="/assets/css/bath-refined.css" />
  </Fragment>

  <a class="skip-link" href="#main">Skip to content</a>
  <SiteHeader minimal={true} />

  <section class="location-hero" aria-labelledby="location-hero-title">
    <img src={heroImage} alt={`${location.name} skyline`} />
    <div class="location-hero-copy">
      <h1 id="location-hero-title" class="location-hero-title location-hero-title-single"><span>{location.name}</span></h1>
    </div>
  </section>
  <div class="page-back-strip"><div class="shell"><a class="page-back-link" href={`/${location.slug}/`}>← Back to {location.name}</a></div></div>

  <main id="main" class="page-shell">
    <div class="shell location-layout location-layout--no-map">
      <LocationSideNav locationSlug={location.slug} locationName={location.name} currentSection="bursaries" />

      <section class="location-main-column" aria-labelledby="bursaries-title">
        <div class="data-page-head">
          <p class="nav-kicker">{location.name} bursaries</p>
          <h2 id="bursaries-title" class="location-grid-title">Bursaries</h2>
          <p class="data-page-note">These summaries are intended as a parent-friendly guide. Schools can change eligibility, deadlines and award levels, so always check the official school website before applying.</p>
        </div>

        <div class="bursary-grid">
          {cards.map((card) => (
            <article class="bursary-square-card">
              <div class="school-square-body">
                <h2>{card.schoolName}</h2>
                <p class="bursary-card-text">{card.summary}</p>
              </div>
            </article>
          ))}
        </div>
      </section>
    </div>
  </main>

  <SiteFooter />
</BaseLayout>
