---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import SiteHeader from '../../../components/SiteHeader.astro';
import SiteFooter from '../../../components/SiteFooter.astro';
import { getLocationPaths, getLocationCompareData } from '../../../lib/directory';

export async function getStaticPaths() {
  return await getLocationPaths();
}

const { location: locationSlug } = Astro.params;
if (!locationSlug) throw new Error('Missing location slug');

const { location, compareSchools } = await getLocationCompareData(locationSlug);
const title = `Compare ${location.name} private schools | The Private School Guide`;
const description = `Compare ${location.name} private schools side by side, switch between the core overview metrics and a dedicated A-level view covering grades, subject breadth and subject mix. Build a shortlist of up to four schools.`;

const overviewColumns = [
  { key: 'name', label: 'School' },
  { key: 'ages', label: 'Ages' },
  { key: 'gender', label: 'Gender' },
  { key: 'format', label: 'Day / boarding' },
  { key: 'dayFee', label: 'Day fees' },
  { key: 'boardingFee', label: 'Boarding fees' },
  { key: 'bursaries', label: 'Bursaries' },
  { key: 'location', label: 'Location' }
] as const;

function formatPercent(value: unknown) {
  if (typeof value !== 'number' || !Number.isFinite(value)) return '—';
  return `${Math.round(value * 100)}%`;
}

function formatCount(value: unknown) {
  if (value === null || value === undefined || value === '') return '—';
  const num = Number(value);
  return Number.isFinite(num) ? num.toLocaleString('en-GB') : '—';
}
---
<BaseLayout
  title={title}
  description={description}
  canonicalPath={`/${location.slug}/compare/`}
  bodyClass="compare-page-body"
  dataLocationSlug={location.slug}
>
  <Fragment slot="head">
    <link rel="stylesheet" href="/assets/css/styles.css" />
    <link rel="stylesheet" href="/assets/css/bath-refined.css" />
  </Fragment>

  <a class="skip-link" href="#main">Skip to content</a>
  <SiteHeader minimal={true} />
  <div class="page-back-strip"><div class="shell"><a class="page-back-link" href={`/${location.slug}/`}>← Back to {location.name}</a></div></div>

  <main id="main">
    <div class="shell compare-page" id="compare-root" data-location-slug={location.slug} data-location-name={location.name} data-default-view="overview">
      <section class="compare-hero">
        <span class="eyebrow">{location.name} compare tool</span>
        <h1>Compare {location.name} private schools</h1>
        <p>Build a shortlist of up to four schools, then switch between the core overview metrics and a dedicated A-level view covering grades, subject breadth and subject mix. Your shortlist is saved on this browser for this location.</p>
        <div class="compare-actions">
          <a href={`/${location.slug}/`} class="compare-link-button">Back to {location.name} guide</a>
          <button id="compare-clear-top" class="compare-inline-button" type="button">Clear selection</button>
        </div>
      </section>

      <section class="compare-layout">
        <section class="compare-main">
          <section class="compare-panel">
            <h2>Build your shortlist</h2>
            <p>Select up to four schools to focus the comparison table. If nothing is selected, the full {location.name} comparison is shown.</p>

            <div id="compare-chooser" class="compare-chooser" aria-label={`Choose ${location.name} schools to compare`}>
              {compareSchools.map((school) => (
                <label class="compare-option">
                  <input type="checkbox" value={school.schoolSlug} />
                  <span class="compare-option-title">{school.name}</span>
                  <span class="compare-option-meta">{school.location || location.name}</span>
                </label>
              ))}
            </div>

            <div class="compare-toolbar">
              <p id="compare-status" class="compare-status" aria-live="polite">Showing all {location.name} schools.</p>
              <div class="compare-toolbar-actions">
                <button id="compare-clear" class="compare-inline-button" type="button">Clear selection</button>
              </div>
            </div>

            <div id="compare-pill-row" class="compare-pill-row" aria-live="polite"></div>
          </section>

          <section class="compare-panel">
            <div class="compare-panel-heading">
              <div>
                <h2>Comparison table</h2>
                <p class="compare-panel-lead">Switch between the overview metrics and the A-level metrics view.</p>
              </div>
              <div class="compare-metric-toggle" role="tablist" aria-label="Comparison table view">
                <button type="button" class="compare-metric-button is-active" data-compare-view="overview" aria-pressed="true">Overview</button>
                <button type="button" class="compare-metric-button" data-compare-view="alevel" aria-pressed="false">A-level metrics</button>
              </div>
            </div>
            <p id="compare-table-note" class="compare-table-note">Overview view covers ages, gender, day or boarding format, annual fees, bursaries and location.</p>
            <div class="compare-table-wrap">
              <table id="compare-table" class="compare-table">
                <thead id="compare-thead">
                  <tr>
                    {overviewColumns.map((col) => <th scope="col">{col.label}</th>)}
                  </tr>
                </thead>
                <tbody id="compare-tbody">
                  {compareSchools.length ? compareSchools.map((school) => (
                    <tr>
                      <th scope="row"><a href={school.slug}>{school.name}</a></th>
                      <td>{school.ages || '—'}</td>
                      <td>{school.gender || '—'}</td>
                      <td>{school.format || '—'}</td>
                      <td>{school.dayFee || '—'}</td>
                      <td>{school.boardingFee || '—'}</td>
                      <td>{school.bursaries || '—'}</td>
                      <td>{school.location || '—'}</td>
                    </tr>
                  )) : (
                    <tr>
                      <td colspan={overviewColumns.length}>Comparison data is coming soon for {location.name}.</td>
                    </tr>
                  )}
                </tbody>
              </table>
            </div>
          </section>
        </section>

        <aside class="compare-sidebar">
          <section class="compare-side-card">
            <h3>How to use this page</h3>
            <p>Start with two or three likely options, compare the practical basics, then move into school profiles and open-day planning.</p>
            <ol class="compare-mini-list">
              <li>Select schools above.</li>
              <li>Use the toggle to switch between overview and A-level metrics.</li>
              <li>Open the profile pages for details and open days.</li>
            </ol>
          </section>

          <section class="compare-side-card">
            <h3>What this page is best for</h3>
            <p>This compare tool is designed for first-pass narrowing, not final judgement. It is strongest on factual differences such as age range, boarding format, annual fees, bursaries and — for senior schools — A-level performance and subject mix.</p>
            <p class="compare-help-note">For fuller context, use the school profiles and open-days guide alongside this page.</p>
          </section>
        </aside>
      </section>
    </div>
  </main>

  <SiteFooter />

  <script type="application/json" id="compare-data">{JSON.stringify(compareSchools)}</script>
  <script is:inline>
    window.comparePageData = {
      defaultView: 'overview',
      locationSlug: {JSON.stringify(location.slug)},
      schools: {JSON.stringify(compareSchools)}
    };
  </script>
  <script defer src="/assets/js/compare.js?v=20260315-compare-ssr"></script>
</BaseLayout>
