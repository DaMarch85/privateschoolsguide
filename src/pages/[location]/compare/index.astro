---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import SiteHeader from '../../../components/SiteHeader.astro';
import SiteFooter from '../../../components/SiteFooter.astro';
import ProvisionFilterSwitch from '../../../components/ProvisionFilterSwitch.astro';
import { getLocationPaths, getLocationCompareData } from '../../../lib/directory';

export async function getStaticPaths() {
  return await getLocationPaths();
}

const { location: locationSlug } = Astro.params;
if (!locationSlug) throw new Error('Missing location slug');

const { location, compareSchools } = await getLocationCompareData(locationSlug);
const title = `Compare ${location.name} private schools | The Private School Guide`;
const description = `Compare ${location.name} private schools side by side across the core overview metrics, with sticky rows and columns for easier scrolling.`;

const overviewRows = [
  { label: 'Ages', values: compareSchools.map((school) => school.ages || '—') },
  { label: 'Gender', values: compareSchools.map((school) => school.gender || '—') },
  { label: 'Day / boarding', values: compareSchools.map((school) => school.format || '—') },
  { label: 'Day fees', values: compareSchools.map((school) => school.dayFee || '—') },
  { label: 'Boarding fees', values: compareSchools.map((school) => school.boardingFee || '—') },
  { label: 'Bursaries', values: compareSchools.map((school) => school.bursaries || '—') },
  { label: 'Location', values: compareSchools.map((school) => school.location || '—') }
];
---
<BaseLayout
  title={title}
  description={description}
  canonicalPath={`/${location.slug}/compare/`}
  bodyClass="compare-page-body"
  dataLocationSlug={location.slug}
>
  <Fragment slot="head">
    <link rel="stylesheet" href="/assets/css/styles.css" />
    <link rel="stylesheet" href="/assets/css/bath-refined.css" />
  </Fragment>

  <a class="skip-link" href="#main">Skip to content</a>
  <SiteHeader minimal={true} />
  <div class="page-back-strip"><div class="shell"><a class="page-back-link" href={`/${location.slug}/`}>← Back to {location.name}</a></div></div>

  <main id="main">
    <div class="shell compare-page" id="compare-root" data-location-slug={location.slug} data-location-name={location.name} data-compare-view="overview">
      <section class="compare-hero">
        <span class="eyebrow">{location.name} compare tool</span>
        <h1>Compare {location.name} private schools</h1>
        <p>Use the hide buttons to narrow the view to the schools you want to focus on. The table keeps the metric column and school headers fixed while you scroll.</p>
        <div class="compare-actions">
          <a href={`/${location.slug}/`} class="compare-link-button">Back to {location.name} guide</a>
        </div>
      </section>

      <section class="compare-layout compare-layout--single">
        <section class="compare-main">
          <section class="compare-panel">
            <div class="compare-panel-heading">
              <div>
                <h2>Comparison table</h2>
                <p class="compare-panel-lead">Switch between the overview metrics and the A-level metrics view.</p>
              </div>
              <nav class="compare-metric-toggle" aria-label="Comparison table view">
                <a href={`/${location.slug}/compare/`} class="compare-metric-button is-active" aria-current="page">Overview</a>
                <a href={`/${location.slug}/compare/a-levels/`} class="compare-metric-button">A-level metrics</a>
              </nav>
            </div>
            <p class="compare-table-note">Overview covers ages, gender, day or boarding format, annual fees, bursaries and location.</p>

            <div class="fees-visibility-bar" data-compare-visibility>
              <div class="fees-visibility-head">
                <p class="fees-visibility-label">School columns</p>
                <button type="button" class="fees-show-all">Show all schools</button>
              </div>
              <div class="fees-visibility-pills" aria-live="polite"></div>
            </div>

            {compareSchools.length ? (
              <>
                <div class="data-table-wrap compare-table-wrap">
                  <table class="fees-matrix compare-matrix">
                    <thead>
                      <tr>
                        <th>Metric</th>
                        {compareSchools.map((school) => (
                          <th
                            data-school-key={school.schoolSlug}
                            data-school-label={school.name}
                            data-provision-category={school.provisionCategory}
                            hidden={school.provisionCategory === 'sen_specialist'}
                          >
                            <span class="fees-school-name">{school.name}</span>
                            <button type="button" class="fees-column-toggle" data-school-key={school.schoolSlug} aria-pressed="false">Hide</button>
                          </th>
                        ))}
                      </tr>
                    </thead>
                    <tbody>
                      {overviewRows.map((row) => (
                        <tr>
                          <th scope="row">{row.label}</th>
                          {row.values.map((value, index) => (
                            <td
                              data-school-key={compareSchools[index]?.schoolSlug}
                              data-provision-category={compareSchools[index]?.provisionCategory}
                              hidden={compareSchools[index]?.provisionCategory === 'sen_specialist'}
                            >
                              {value || '—'}
                            </td>
                          ))}
                        </tr>
                      ))}
                    </tbody>
                  </table>
                </div>
                <p class="data-page-note provision-filter-note" data-compare-empty hidden>No schools match the selected school type.</p>
              </>
            ) : (
              <p class="data-page-note">Comparison data is being updated for {location.name}.</p>
            )}
          </section>
        </section>
      </section>

      <ProvisionFilterSwitch label={`Show ${location.name} schools`} />
    </div>
  </main>

  <SiteFooter />
  <script defer src="/assets/js/school-provision-filter.js?v=20260319-location-filter"></script>
  <script defer src="/assets/js/compare.js?v=20260319-compare-sen-filter"></script>
</BaseLayout>
