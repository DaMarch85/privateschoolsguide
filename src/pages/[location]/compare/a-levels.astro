---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import SiteHeader from '../../../components/SiteHeader.astro';
import SiteFooter from '../../../components/SiteFooter.astro';
import { getLocationPaths, getLocationCompareData } from '../../../lib/directory';

export async function getStaticPaths() {
  return await getLocationPaths();
}

const { location: locationSlug } = Astro.params;
if (!locationSlug) throw new Error('Missing location slug');

const { location, compareSchools } = await getLocationCompareData(locationSlug);
const title = `Compare ${location.name} A-levels | The Private School Guide`;
const description = `Compare ${location.name} private school A-level grades, subject breadth and subject mix side by side.`;

function formatPercent(value: unknown) {
  if (typeof value !== 'number' || !Number.isFinite(value)) return '—';
  return `${Math.round(value * 100)}%`;
}

function formatCount(value: unknown) {
  if (value === null || value === undefined || value === '') return '—';
  const num = Number(value);
  return Number.isFinite(num) ? num.toLocaleString('en-GB') : '—';
}

const alevelRows = [
  { label: 'Total exams', values: compareSchools.map((school) => formatCount(school.alevel?.totalExams)) },
  { label: '%A*/A', values: compareSchools.map((school) => formatPercent(school.alevel?.pctAStarA)) },
  { label: '%A*-B', values: compareSchools.map((school) => formatPercent(school.alevel?.pctAStarB)) },
  { label: 'Unique subjects', values: compareSchools.map((school) => formatCount(school.alevel?.uniqueSubjects)) },
  { label: 'Core science', values: compareSchools.map((school) => formatPercent(school.alevel?.coreScience)) },
  { label: 'Mathematics', values: compareSchools.map((school) => formatPercent(school.alevel?.mathematics)) },
  { label: 'Art', values: compareSchools.map((school) => formatPercent(school.alevel?.art)) },
  { label: 'Languages', values: compareSchools.map((school) => formatPercent(school.alevel?.languages)) },
  { label: 'Economics', values: compareSchools.map((school) => formatPercent(school.alevel?.economics)) },
  { label: 'English', values: compareSchools.map((school) => formatPercent(school.alevel?.english)) },
  { label: 'History', values: compareSchools.map((school) => formatPercent(school.alevel?.history)) },
  { label: 'Geography', values: compareSchools.map((school) => formatPercent(school.alevel?.geography)) },
  { label: 'Psychology', values: compareSchools.map((school) => formatPercent(school.alevel?.psychology)) },
  { label: 'Other', values: compareSchools.map((school) => formatPercent(school.alevel?.other)) }
];
---
<BaseLayout
  title={title}
  description={description}
  canonicalPath={`/${location.slug}/compare/a-levels/`}
  bodyClass="compare-page-body"
  dataLocationSlug={location.slug}
>
  <Fragment slot="head">
    <link rel="stylesheet" href="/assets/css/styles.css" />
    <link rel="stylesheet" href="/assets/css/bath-refined.css" />
  </Fragment>

  <a class="skip-link" href="#main">Skip to content</a>
  <SiteHeader minimal={true} />
  <div class="page-back-strip"><div class="shell"><a class="page-back-link" href={`/${location.slug}/`}>← Back to {location.name}</a></div></div>

  <main id="main">
    <div class="shell compare-page" id="compare-root" data-location-slug={location.slug} data-location-name={location.name} data-compare-view="alevel">
      <section class="compare-hero">
        <span class="eyebrow">{location.name} compare tool</span>
        <h1>Compare {location.name} private schools</h1>
        <p>Use the hide buttons to focus the table on the schools you want to keep in view. The metric column and school headers stay visible as you scroll.</p>
        <div class="compare-actions">
          <a href={`/${location.slug}/`} class="compare-link-button">Back to {location.name} guide</a>
        </div>
      </section>

      <section class="compare-layout compare-layout--single">
        <section class="compare-main">
          <section class="compare-panel">
            <div class="compare-panel-heading">
              <div>
                <h2>Comparison table</h2>
                <p class="compare-panel-lead">Switch between the overview metrics and the A-level metrics view.</p>
              </div>
              <nav class="compare-metric-toggle" aria-label="Comparison table view">
                <a href={`/${location.slug}/compare/`} class="compare-metric-button">Overview</a>
                <a href={`/${location.slug}/compare/a-levels/`} class="compare-metric-button is-active" aria-current="page">A-level metrics</a>
              </nav>
            </div>
            <p class="compare-table-note">A-level view covers total exams, grades, unique subjects and subject mix.</p>

            <div class="fees-visibility-bar" data-compare-visibility>
              <div class="fees-visibility-head">
                <p class="fees-visibility-label">School columns</p>
                <button type="button" class="fees-show-all">Show all schools</button>
              </div>
              <div class="fees-visibility-pills" aria-live="polite"></div>
            </div>

            {compareSchools.length ? (
              <div class="data-table-wrap compare-table-wrap">
                <table class="fees-matrix compare-matrix">
                  <thead>
                    <tr>
                      <th>Metric</th>
                      {compareSchools.map((school) => (
                        <th data-school-key={school.schoolSlug} data-school-label={school.name}>
                          <span class="fees-school-name">{school.name}</span>
                          <button type="button" class="fees-column-toggle" data-school-key={school.schoolSlug} aria-pressed="false">Hide</button>
                        </th>
                      ))}
                    </tr>
                  </thead>
                  <tbody>
                    {alevelRows.map((row) => (
                      <tr>
                        <th scope="row">{row.label}</th>
                        {row.values.map((value) => <td>{value || '—'}</td>)}
                      </tr>
                    ))}
                  </tbody>
                </table>
              </div>
            ) : (
              <p class="data-page-note">Comparison data is being updated for {location.name}.</p>
            )}
          </section>
        </section>
      </section>
    </div>
  </main>

  <SiteFooter />
  <script defer src="/assets/js/compare.js?v=20260315-compare-matrix"></script>
</BaseLayout>
