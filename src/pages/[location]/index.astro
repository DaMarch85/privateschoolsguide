---
import BaseLayout from '../../layouts/BaseLayout.astro';
import SiteHeader from '../../components/SiteHeader.astro';
import SiteFooter from '../../components/SiteFooter.astro';
import LocationSideNav from '../../components/LocationSideNav.astro';
import SchoolSquareCard from '../../components/SchoolSquareCard.astro';
import { getLocationPaths, getLocationDirectoryData } from '../../lib/directory';
import { getLocationPresentation } from '../../lib/location-config';

export async function getStaticPaths() {
  return await getLocationPaths();
}

const { location: locationSlug } = Astro.params;
if (!locationSlug) throw new Error('Missing location slug');

const { location, schoolCards, mapSchools } = await getLocationDirectoryData(locationSlug);
const presentation = getLocationPresentation(location.slug, location.name);
const heroSubtitle = presentation.heroSubtitle;
const fallbackMetaTitle = `${location.name} private schools | The Private School Guide`;
const fallbackMetaDescription = `Independent guide to ${location.name} private schools. Compare schools, review fees and bursaries, explore open days, and use the map to narrow your shortlist.`;
const locationMapScript = `window.locationPageMapData = ${JSON.stringify(mapSchools)};`;

const fallbackLatValue = location.latitude !== null ? Number(location.latitude) : NaN;
const fallbackLngValue = location.longitude !== null ? Number(location.longitude) : NaN;
const fallbackLat = Number.isFinite(fallbackLatValue) ? fallbackLatValue : null;
const fallbackLng = Number.isFinite(fallbackLngValue) ? fallbackLngValue : null;
---
<BaseLayout
  title={location.meta_title || fallbackMetaTitle}
  description={location.meta_description || fallbackMetaDescription}
  canonicalPath={`/${location.slug}/`}
  includeLeaflet={true}
  bodyClass="location-page"
  dataLocationSlug={location.slug}
>
  <Fragment slot="head">
    <link rel="stylesheet" href="/assets/css/styles.css" />
    <link rel="stylesheet" href="/assets/css/bath-refined.css" />
    <style>
      .location-hero-subtitle {
        display: block;
        width: 100%;
        margin: 14px auto 0;
        text-align: center;
        color: rgba(255, 255, 255, 0.95);
        font-style: italic;
        font-weight: 400;
        font-size: clamp(1.25rem, 2.2vw, 1.5rem);
        line-height: 1.35;
        letter-spacing: 0.02em;
        max-width: none;
      }

      @media (max-width: 720px) {
        .location-hero-subtitle {
          margin-top: 10px;
          font-size: 1.25rem;
          line-height: 1.35;
        }
      }
    </style>
  </Fragment>

  <a class="skip-link" href="#main">Skip to content</a>
  <SiteHeader minimal={true} />

  <section class="location-hero" aria-labelledby="location-hero-title">
    <img src={presentation.heroImage} alt={presentation.heroImageAlt} />
    <div class="location-hero-copy">
      <h1 id="location-hero-title" class="location-hero-title location-hero-title-single">
        <span>{location.hero_title || location.name}</span>
      </h1>
      {heroSubtitle && <p class="location-hero-subtitle">{heroSubtitle}</p>}
    </div>
  </section>
  <div class="page-back-strip"><div class="shell"><a class="page-back-link" href="/">Back to homepage</a></div></div>

  <main id="main" class="page-shell">
    <div class="shell location-layout">
      <LocationSideNav locationSlug={location.slug} locationName={location.name} />

      <section class="location-main-column" aria-labelledby="location-grid-title">
        <h2 id="location-grid-title" class="location-grid-title">{location.name} private schools</h2>
        {location.intro_text ? <p class="location-intro">{location.intro_text}</p> : null}
        <div class="school-square-grid">
          {schoolCards.map((school) => (
            <SchoolSquareCard {...school} />
          ))}
        </div>
      </section>

      <aside class="location-map-panel">
        <div class="location-map-head">
          <p class="nav-kicker">{location.name} map</p>
          <h2>School locations</h2>
        </div>
        <div
          id="location-directory-map"
          class="bath-location-map"
          aria-label={`${location.name} school map`}
          data-directory-map
          data-map-data-id="location-map-data"
          data-fallback-lat={fallbackLat ?? undefined}
          data-fallback-lng={fallbackLng ?? undefined}
          data-fallback-zoom="11"
        ></div>
        <p id="location-map-empty" class="location-intro" hidden>School locations are being updated.</p>
      </aside>
    </div>
  </main>

  <SiteFooter />

  <script is:inline set:html={locationMapScript}></script>
  <script type="application/json" id="location-map-data">{JSON.stringify(mapSchools)}</script>
  <script defer src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js" integrity="sha256-20nQCchB9co0qIjJZRGuk2/Z9VM+kNiyxNV1lvTlZBo=" crossorigin=""></script>
  <script defer src="/assets/js/location-pages.js?v=20260316-location-map-fix"></script>
</BaseLayout>
