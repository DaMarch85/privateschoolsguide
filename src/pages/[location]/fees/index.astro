---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import SiteHeader from '../../../components/SiteHeader.astro';
import SiteFooter from '../../../components/SiteFooter.astro';
import LocationSideNav from '../../../components/LocationSideNav.astro';
import { formatCurrency, getLocationFeesData, getLocationPaths } from '../../../lib/directory';

export async function getStaticPaths() {
  return await getLocationPaths();
}

const { location: locationSlug } = Astro.params;
if (!locationSlug) throw new Error('Missing location slug');

const { location, schoolHeaders, currentAcademicYear, allFeesIncludeVat, views } = await getLocationFeesData(locationSlug);
const heroImage = '/assets/img/bath/bath-location-hero.jpg';
const title = `${location.name} private school fees | The Private School Guide`;
const description = `Annual ${location.name} private school fees including VAT, with day and boarding views by year group.`;
---
<BaseLayout
  title={title}
  description={description}
  canonicalPath={`/${location.slug}/fees/`}
  bodyClass="location-page location-page--data"
  dataLocationSlug={location.slug}
>
  <Fragment slot="head">
    <link rel="stylesheet" href="/assets/css/styles.css" />
    <link rel="stylesheet" href="/assets/css/bath-refined.css" />
  </Fragment>

  <a class="skip-link" href="#main">Skip to content</a>
  <SiteHeader minimal={true} />

  <section class="location-hero" aria-labelledby="location-hero-title">
    <img src={heroImage} alt={`${location.name} skyline`} />
    <div class="location-hero-copy">
      <h1 id="location-hero-title" class="location-hero-title location-hero-title-single"><span>{location.name}</span></h1>
    </div>
  </section>
  <div class="page-back-strip"><div class="shell"><a class="page-back-link" href={`/${location.slug}/`}>← Back to {location.name}</a></div></div>

  <main id="main" class="page-shell">
    <div class="shell location-layout location-layout--no-map">
      <LocationSideNav locationSlug={location.slug} locationName={location.name} currentSection="fees" />

      <section class="location-main-column" aria-labelledby="fees-title">
        <div class="data-page-head">
          <p class="nav-kicker">{location.name} fees</p>
          <h2 id="fees-title" class="location-grid-title">Annual fees</h2>
          <p class="data-page-note">
            {allFeesIncludeVat ? 'Annual fees including VAT.' : 'Annual fees. Please check the school for VAT treatment.'}
            {currentAcademicYear ? ` ${currentAcademicYear}.` : ''}
            {' '}Schools that do not offer the selected format are shown as —. Always verify current fees and extras directly with the school.
          </p>
        </div>

        {views.length > 1 && (
          <div class="fees-switch" data-fees-switch>
            {views.map((view, index) => (
              <button class={index === 0 ? 'is-active' : undefined} type="button" data-fees-view={view.feeType}>{view.label}</button>
            ))}
          </div>
        )}

        {views.length ? views.map((view, index) => (
          <div class="data-table-wrap" data-fees-table={view.feeType} hidden={index !== 0}>
            <table class="fees-matrix">
              <thead>
                <tr>
                  <th>Year</th>
                  {schoolHeaders.map((school) => <th>{school.schoolName}</th>)}
                </tr>
              </thead>
              <tbody>
                {view.rows.map((row) => (
                  <tr>
                    <th scope="row">{row.label}</th>
                    {row.cells.map((cell) => <td>{cell.amount !== null ? formatCurrency(cell.amount) : '—'}</td>)}
                  </tr>
                ))}
              </tbody>
            </table>
          </div>
        )) : <p class="data-page-note">Fee information is being updated.</p>}
      </section>
    </div>
  </main>

  <SiteFooter />
  <script defer src="/assets/js/bath-refined.js?v=20260315-fees-generic"></script>
</BaseLayout>
