---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import SiteHeader from '../../../components/SiteHeader.astro';
import SiteFooter from '../../../components/SiteFooter.astro';
import {
  getAllLocationSchoolPaths,
  getLocationSchoolProfile,
  formatCurrency,
  formatPercent,
  formatInteger,
  splitParagraphs
} from '../../../lib/directory';

export async function getStaticPaths() {
  return await getAllLocationSchoolPaths();
}

const { location: locationSlug, slug } = Astro.params;
if (!locationSlug || !slug) throw new Error('Missing location or school slug');

const profile = await getLocationSchoolProfile(locationSlug, slug);
const schoolMapScript = `window.schoolProfileMapData = ${JSON.stringify(profile.mapData)};`;
const schoolNearbyMapScript = `window.schoolProfileNearbyMapData = ${JSON.stringify(profile.nearbyMapSchools || [])};`;
const schoolMapJson = JSON.stringify(profile.mapData);
const schoolNearbyMapJson = JSON.stringify(profile.nearbyMapSchools || []);
const heroSlides = Array.from(
  new Map(
    [
      { url: profile.heroImageUrl, alt: profile.heroImageAlt || `${profile.school.name} hero image`, imageType: 'hero' },
      ...profile.galleryImages
    ]
      .filter((image) => Boolean(image?.url))
      .map((image) => [image.url, image])
  ).values()
);
---
<BaseLayout
  title={`${profile.school.name} | ${profile.location.name} school profile`}
  description={profile.subhead}
  canonicalPath={profile.canonicalPath}
  includeLeaflet={true}
  bodyClass="school-profile-page"
  dataLocationSlug={profile.location.slug}
  dataSchoolSlug={profile.school.slug}
>
  <Fragment slot="head">
    <link rel="stylesheet" href="/assets/css/styles.css" />
    <link rel="stylesheet" href="/assets/css/bath-refined.css?v=20260408b-school-page-refresh" />
  </Fragment>

  <a class="skip-link" href="#main">Skip to content</a>
  <SiteHeader minimal={true} />

  <section aria-labelledby="school-page-title" class={`school-profile-hero ${heroSlides.length > 1 ? 'school-profile-hero--slideshow' : ''}`}>
    <div class="school-profile-hero-media" data-hero-slideshow={heroSlides.length > 1 ? 'true' : undefined}>
      {heroSlides.map((image, index) => (
        <img
          alt={image.alt || `${profile.school.name} image ${index + 1}`}
          class={`school-profile-hero-slide ${index === 0 ? 'is-active' : ''}`}
          data-hero-slide
          loading={index === 0 ? 'eager' : 'lazy'}
          src={image.url}
        />
      ))}

      {heroSlides.length > 1 ? (
        <div class="school-profile-hero-controls" aria-label="School image gallery controls">
          <button aria-label="Previous school image" class="school-profile-hero-control" data-hero-prev type="button">←</button>
          <div class="school-profile-hero-dots" role="tablist" aria-label="School image slides">
            {heroSlides.map((image, index) => (
              <button
                aria-label={`Show image ${index + 1}`}
                class={`school-profile-hero-dot ${index === 0 ? 'is-active' : ''}`}
                data-hero-dot
                data-hero-index={index}
                type="button"
              ></button>
            ))}
          </div>
          <button aria-label="Next school image" class="school-profile-hero-control" data-hero-next type="button">→</button>
        </div>
      ) : null}
    </div>
    <div class="school-profile-hero-copy">
      {(profile.profileBadgeLabel || profile.profileManagedLabel) ? (
        <div class="school-profile-status-row">
          {profile.profileBadgeLabel ? <p class="school-profile-status school-profile-status--featured">{profile.profileBadgeLabel}</p> : null}
          {profile.profileManagedLabel ? <p class="school-profile-status">{profile.profileManagedLabel}</p> : null}
        </div>
      ) : null}
      <h1 class="school-profile-title" id="school-page-title">{profile.school.name}</h1>
      <p class="school-profile-subhead">{profile.subhead}</p>
      {(profile.officialWebsiteUrl || profile.contactFormUrl) ? (
        <div class="school-profile-actions">
          {profile.officialWebsiteUrl ? <a class="button school-profile-website-link" href={profile.officialWebsiteUrl} rel="noopener noreferrer" target="_blank">Visit school website</a> : null}
          {profile.contactFormUrl ? <a class="button-outline school-profile-contact-link" href={profile.contactFormUrl} rel="noopener noreferrer" target="_blank">Admissions / contact form</a> : null}
        </div>
      ) : null}
    </div>
  </section>
  <div class="school-back-strip"><div class="shell"><a class="school-back-link" href={`/${profile.location.slug}/`}>← Back to {profile.location.name}</a></div></div>
  <div class="school-compare-floating-bar" data-compare-floating-bar hidden>
    <div class="shell school-compare-floating-bar__inner">
      <p class="school-compare-floating-bar__text" data-compare-floating-label>Comparing schools</p>
      <button class="school-compare-floating-bar__button" data-compare-floating-close type="button">Close comparison school ×</button>
    </div>
  </div>

  <main class="page-shell" id="main">
    <div class="shell school-profile-layout">
      <aside class="school-side-column">
        <section class="school-side-section">
          <p class="nav-kicker">At a glance</p>
          <div class="school-glance-table">
            {profile.atGlanceRows.map((row) => (
              <div class="school-glance-row"><span class="school-glance-label">{row.label}</span><span class="school-glance-value">{row.value}</span></div>
            ))}
          </div>
        </section>

        <section class="school-side-section school-compare-section">
          <div class="school-compare-section-head">
            <p class="nav-kicker">Compare with</p>
            <button aria-controls="school-compare-links-panel" aria-expanded="false" class="school-compare-toggle" data-compare-toggle type="button">Compare with nearby schools</button>
          </div>
          <div class="school-compare-links-panel" data-compare-links-panel hidden id="school-compare-links-panel">
            <ul class="school-compare-links">
              {profile.compareLinks.map((link) => (
                <li>
                  <a data-compare-school={link.slug} href={`?compare=${encodeURIComponent(link.slug)}`}>{link.name}</a>
                </li>
              ))}
            </ul>
            <button class="school-compare-toggle school-compare-toggle--secondary" data-compare-hide type="button">Hide nearby schools</button>
          </div>
        </section>
      </aside>

      <section class="school-profile-main">
        <div class="school-feature-grid">
          <article class="school-feature-tile">
            <h2>How the school describes itself</h2>
            <div class="school-feature-body">
              <div class="school-card-copy">
                {profile.schoolVoice.length > 0 ? (
                  <ul>
                    {profile.schoolVoice.map((item) => <li>{item}</li>)}
                  </ul>
                ) : (
                  <p>Coming soon</p>
                )}
              </div>
            </div>
          </article>

          {profile.feePanes.length > 0 && (
            <article class={`school-feature-tile ${profile.feePanes.length > 1 ? 'tile-expandable' : ''}`}>
              <h2>Fee profile</h2>
              <div class="school-feature-body">
                <p class="tile-note">
                  {profile.allFeesIncludeVat ? 'Annual fees including VAT.' : 'Annual fees. Please check the school for VAT treatment.'}
                  {profile.currentAcademicYear ? ` ${profile.currentAcademicYear}.` : ''}
                </p>

                {profile.feePanes.length > 1 && (
                  <div class="fee-switch" data-fee-switch>
                    {profile.feePanes.map((pane, index) => (
                      <button class={index === 0 ? 'is-active' : undefined} data-fee-target={pane.feeType} type="button">{pane.label}</button>
                    ))}
                  </div>
                )}

                {profile.feePanes.map((pane, index) => (
                  <div class={`fee-pane ${index === 0 ? 'is-active' : ''}`} data-fee-pane={pane.feeType}>
                    <div class="fee-year-columns">
                      {pane.columns.map((column) => (
                        <div class="fee-year-column">
                          {column.map((row) => (
                            <div class="fee-year-row"><span class="fee-year">{row.year_group_label}</span><span class="fee-amount">{formatCurrency(row.amount_gbp)}</span></div>
                          ))}
                        </div>
                      ))}
                    </div>
                  </div>
                ))}
              </div>
            </article>
          )}

          {profile.alevelResult && (
            <article class="school-feature-tile">
              <h2>A-level results</h2>
              <div class="school-feature-body">
                <div class="tile-kpis">
                  <div class="tile-kpi"><span class="tile-kpi-label">% A*–A</span><span class="tile-kpi-value">{formatPercent(profile.alevelResult.pct_a_star_a)}</span></div>
                  <div class="tile-kpi"><span class="tile-kpi-label">% A*–B</span><span class="tile-kpi-value">{formatPercent(profile.alevelResult.pct_a_star_b)}</span></div>
                  <div class="tile-kpi"><span class="tile-kpi-label">Different A-level subjects</span><span class="tile-kpi-value">{formatInteger(profile.alevelResult.unique_subjects)}</span></div>
                </div>
                <p class="tile-note">Results shown for {profile.alevelResult.result_year}.</p>
              </div>
            </article>
          )}

          {profile.subjectRows.length > 0 && (
            <article class={`school-feature-tile ${profile.subjectExtraRows.length ? 'tile-expandable' : ''}`}>
              <h2>Popular subjects</h2>
              <div class="school-feature-body">
                <div class="metric-list">
                  {profile.subjectTopRows.map((subject) => (
                    <div class="metric-row"><span class="metric-name">{subject.subject_name}</span><span class="metric-value">{formatPercent(subject.share_of_entries)}</span></div>
                  ))}
                </div>
                {profile.subjectExtraRows.length > 0 && (
                  <Fragment>
                    <button class="subject-toggle" data-subject-toggle="expand" type="button">Show full subject mix</button>
                    <div class="subject-extra" hidden>
                      <div class="metric-list">
                        {profile.subjectExtraRows.map((subject) => (
                          <div class="metric-row"><span class="metric-name">{subject.subject_name}</span><span class="metric-value">{formatPercent(subject.share_of_entries)}</span></div>
                        ))}
                      </div>
                      <button class="subject-toggle subject-toggle--collapse" data-subject-toggle="collapse" type="button">Collapse subject mix</button>
                    </div>
                  </Fragment>
                )}
              </div>
            </article>
          )}

          <article class="school-feature-tile">
            <h2>Parents like</h2>
            <div class="school-feature-body">
              <div class="school-card-copy">
                {profile.parentLikes.length > 0 ? (
                  <ul>
                    {profile.parentLikes.map((item) => <li>{item}</li>)}
                  </ul>
                ) : (
                  <p>Coming soon</p>
                )}
              </div>
            </div>
          </article>

          {profile.content?.admissions_summary ? (
            <article class="school-feature-tile">
              <h2>Admissions</h2>
              <div class="school-feature-body">
                <div class="school-card-copy">
                  {splitParagraphs(profile.content.admissions_summary).map((paragraph) => <p>{paragraph}</p>)}
                </div>
              </div>
            </article>
          ) : null}

          <article class="school-feature-tile">
            <h2>Scholarships</h2>
            <div class="school-feature-body">
              <div class="school-card-copy">
                {profile.content?.scholarships ? (
                  profile.scholarshipBullets.length > 1 ? (
                    <ul>
                      {profile.scholarshipBullets.map((item) => <li>{item}</li>)}
                    </ul>
                  ) : (
                    splitParagraphs(profile.content.scholarships).map((paragraph) => <p>{paragraph}</p>)
                  )
                ) : (
                  <p>Coming soon</p>
                )}
              </div>
            </div>
          </article>

          {profile.bursary ? (
            <article class="school-feature-tile">
              <h2>Bursaries</h2>
              <div class="school-feature-body">
                {profile.bursary.summary ? <p>{profile.bursary.summary}</p> : null}
                {profile.bursaryBullets.length > 0 ? (
                  <div class="school-card-copy">
                    <ul>
                      {profile.bursaryBullets.map((item) => <li>{item}</li>)}
                    </ul>
                  </div>
                ) : null}
              </div>
            </article>
          ) : null}

          {profile.content?.inspection_snapshot || profile.school.inspection_rating ? (
            <article class="school-feature-tile">
              <h2>Inspection snapshot</h2>
              <div class="school-feature-body">
                <div class="school-card-copy">
                  {profile.inspectionBullets.length > 1 ? (
                    <ul>
                      {profile.inspectionBullets.map((item) => <li>{item}</li>)}
                    </ul>
                  ) : (
                    splitParagraphs(profile.content?.inspection_snapshot || profile.school.inspection_rating).map((paragraph) => <p>{paragraph}</p>)
                  )}
                </div>
              </div>
            </article>
          ) : null}

          {profile.content?.assessment_approach ? (
            <article class="school-feature-tile">
              <h2>Assessment approach</h2>
              <div class="school-feature-body">
                <div class="school-card-copy">
                  {profile.assessmentBullets.length > 1 ? (
                    <ul>
                      {profile.assessmentBullets.map((item) => <li>{item}</li>)}
                    </ul>
                  ) : (
                    splitParagraphs(profile.content.assessment_approach).map((paragraph) => <p>{paragraph}</p>)
                  )}
                </div>
              </div>
            </article>
          ) : null}

          <article class="school-feature-tile school-feature-tile--cta">
            <h2>For schools</h2>
            <div class="school-feature-body">
              <div class="school-card-copy">
                <p>School staff? Join or improve this profile.</p>
                <p>Upload official imagery, add your website and admissions links, and choose a school-supported membership package.</p>
              </div>
              <a class="button-outline school-feature-tile__cta" href={`/claim-your-profile/?school=${profile.school.id}`}>Go to the school portal</a>
            </div>
          </article>
        </div>
      </section>

      <aside class="location-map-panel school-map-panel">
        <div class="location-map-head">
          <p class="nav-kicker">Map</p>
          <h2>School location</h2>
        </div>
        <div aria-label={`Map showing ${profile.school.name}`} class="bath-location-map school-page-map" id="school-page-map"></div>
        <p class="map-caption">{profile.address}</p>
        <div class="school-map-actions">
          {profile.parentLocationHref ? <a class="school-map-action school-map-action--secondary" href={profile.parentLocationHref}>Back to {profile.parentLocationName || profile.location.name}</a> : null}
          <a class="school-map-action school-map-action--primary" href={profile.changeSearchHref}>Change search area</a>
        </div>
      </aside>
    </div>
  </main>

  <SiteFooter />

  <script is:inline set:html={schoolMapScript}></script>
  <script is:inline set:html={schoolNearbyMapScript}></script>
  <script id="school-map-data" is:inline set:html={schoolMapJson} type="application/json"></script>
  <script id="school-nearby-map-data" is:inline set:html={schoolNearbyMapJson} type="application/json"></script>
  <script defer src="/assets/js/site.js"></script>
  <script defer src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js" integrity="sha256-20nQCchB9co0qIjJZRGuk2/Z9VM+kNiyxNV1lvTlZBo=" crossorigin=""></script>
  <script defer src="https://unpkg.com/maplibre-gl@5.21.1/dist/maplibre-gl.js" crossorigin=""></script>
  <script defer src="https://unpkg.com/@maplibre/maplibre-gl-leaflet@0.1.3/leaflet-maplibre-gl.js" crossorigin=""></script>
  <script defer src="/assets/js/school-pages.js?v=20260408b-school-compare-map-refresh"></script>
</BaseLayout>
