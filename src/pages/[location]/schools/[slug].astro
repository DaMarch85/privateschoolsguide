---
import SchoolProfilePage from '../../../components/SchoolProfilePage.astro';
import {
  getAllLocationSchoolPaths,
  getLocationSchoolProfile
} from '../../../lib/directory';

export async function getStaticPaths() {
  return await getAllLocationSchoolPaths();
}

const { location, slug } = Astro.params;
if (!location || !slug) throw new Error('Missing location or school slug');

const profile = await getLocationSchoolProfile(location, slug);
---
<SchoolProfilePage
  canonicalPath={profile.canonicalPath}
  description={profile.subhead}
  profile={profile}
  title={`${profile.school.name} | ${profile.location.name} school profile`}
/>
