---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import SiteHeader from '../../../components/SiteHeader.astro';
import SiteFooter from '../../../components/SiteFooter.astro';
import LocationSideNav from '../../../components/LocationSideNav.astro';
import ProvisionFilterSwitch from '../../../components/ProvisionFilterSwitch.astro';
import { getLocationOpenDaysData, getLocationPaths } from '../../../lib/directory';
import { getLocationPresentation } from '../../../lib/location-config';

export async function getStaticPaths() {
  return await getLocationPaths();
}

const { location: locationSlug } = Astro.params;
if (!locationSlug) throw new Error('Missing location slug');

const { location, openDays, lastVerifiedAt } = await getLocationOpenDaysData(locationSlug);
const { heroImage, heroImageAlt } = getLocationPresentation(location.slug, location.name);
const title = `${location.name} private school open days | The Private School Guide`;
const description = `Upcoming open days and visit links for ${location.name} private schools.`;

function formatDate(value: string | null) {
  if (!value) return 'Date to be confirmed';
  const date = new Date(value);
  if (Number.isNaN(date.getTime())) return 'Date to be confirmed';
  return new Intl.DateTimeFormat('en-GB', {
    weekday: 'short',
    day: 'numeric',
    month: 'short',
    year: 'numeric'
  }).format(date);
}

function formatTimeRange(startAt: string | null, endAt: string | null) {
  if (!startAt) return '';
  const start = new Date(startAt);
  if (Number.isNaN(start.getTime())) return '';

  const timeFormat = new Intl.DateTimeFormat('en-GB', {
    hour: 'numeric',
    minute: '2-digit'
  });

  const startText = timeFormat.format(start);
  if (!endAt) return startText;
  const end = new Date(endAt);
  if (Number.isNaN(end.getTime())) return startText;
  return `${startText}–${timeFormat.format(end)}`;
}

const lastVerifiedLabel = lastVerifiedAt
  ? new Intl.DateTimeFormat('en-GB', { day: 'numeric', month: 'long', year: 'numeric' }).format(new Date(lastVerifiedAt))
  : null;
---
<BaseLayout
  title={title}
  description={description}
  canonicalPath={`/${location.slug}/open-days/`}
  bodyClass="location-page location-page--data"
  dataLocationSlug={location.slug}
>
  <Fragment slot="head">
    <link rel="stylesheet" href="/assets/css/styles.css" />
    <link rel="stylesheet" href="/assets/css/bath-refined.css" />
  </Fragment>

  <a class="skip-link" href="#main">Skip to content</a>
  <SiteHeader minimal={true} />

  <section class="location-hero" aria-labelledby="location-hero-title">
    <img src={heroImage} alt={heroImageAlt} />
    <div class="location-hero-copy">
      <h1 id="location-hero-title" class="location-hero-title location-hero-title-single"><span>{location.name}</span></h1>
    </div>
  </section>
  <div class="page-back-strip"><div class="shell"><a class="page-back-link" href={`/${location.slug}/`}>← Back to {location.name}</a></div></div>

  <main id="main" class="page-shell">
    <div class="shell location-layout location-layout--no-map">
      <LocationSideNav locationSlug={location.slug} locationName={location.name} currentSection="open-days" />

      <section class="location-main-column" aria-labelledby="open-days-title">
        <div class="data-page-head">
          <p class="nav-kicker">{location.name} open days</p>
          <h2 id="open-days-title" class="location-grid-title">Open days</h2>
          <p class="data-page-note">Always re-check directly with the school before travelling, as dates, times and booking requirements can change.</p>
          {lastVerifiedLabel ? <p class="data-page-note"><strong>Last verified:</strong> {lastVerifiedLabel}</p> : null}
        </div>

        {openDays.length ? (
          <>
            <div class="data-table-wrap" data-provision-container="open-days">
              <table class="fees-matrix open-days-matrix">
                <thead>
                  <tr>
                    <th>Date</th>
                    <th>School</th>
                    <th>Event</th>
                    <th>Notes</th>
                  </tr>
                </thead>
                <tbody>
                  {openDays.map((item) => (
                    <tr data-open-day-row data-provision-category={item.provisionCategory} hidden={item.provisionCategory === 'sen_specialist'}>
                      <th scope="row">{formatDate(item.startAt)}</th>
                      <td><a href={`/${location.slug}/schools/${item.schoolSlug}/`}>{item.schoolName}</a></td>
                      <td>
                        <div>{item.title}</div>
                        {item.bookingUrl ? <div><a href={item.bookingUrl} rel="noreferrer" target="_blank">Book / details</a></div> : null}
                      </td>
                      <td>{[formatTimeRange(item.startAt, item.endAt), item.notes].filter(Boolean).join('; ') || '—'}</td>
                    </tr>
                  ))}
                </tbody>
              </table>
            </div>
            <p class="data-page-note provision-filter-note" data-provision-empty="open-days" hidden>No schools match the selected school type.</p>
          </>
        ) : (
          <p class="data-page-note">Open day information is being updated.</p>
        )}

        <ProvisionFilterSwitch label={`Show ${location.name} schools`} />
      </section>
    </div>
  </main>

  <SiteFooter />
  <script defer src="/assets/js/school-provision-filter.js?v=20260319-location-filter"></script>
</BaseLayout>
